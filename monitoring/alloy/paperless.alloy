local.file_match "paperless_logs" {
    path_targets = [
        {
            __path__="/var/docker_logs/paperless/nico/paperless.log",
            instance = "nico",
            job = "paperless",
            service="paperless",
        },
        {
             __path__="/var/docker_logs/paperless/nico/celery.log",
             instance = "nico",
             job = "celery",
             service="paperless",
        },
        {
            __path__="/var/docker_logs/paperless/ilka/paperless.log",
            instance = "ilka",
            job = "paperless",
            service="paperless",
        },
        {
             __path__="/var/docker_logs/paperless/ilka/celery.log",
             instance = "ilka",
             job = "celery",
             service="paperless",
        },
        {
            __path__="/var/docker_logs/paperless/hannelore/paperless.log",
            instance = "hannelore",
            job = "paperless",
            service="paperless",
        },
        {
             __path__="/var/docker_logs/paperless/hannelore/celery.log",
             instance = "hannelore",
             job = "celery",
             service="paperless",
        },
    ]
}

loki.source.file "read_paperless_logs" {
    targets = local.file_match.paperless_logs.targets
    forward_to = [loki.process.process_paperless_logs.receiver]
}

loki.process "process_paperless_logs" {
    // 1. Die Werte per Regex extrahieren
    // Wir nutzen benannte Gruppen (?P<name>...), um die Variablen zu füllen
    stage.regex {
        // Beachte die doppelten Backslashes \\ vor den eckigen Klammern
        expression = "^\\[(?P<time>.*?)\\] \\[(?P<level>.*?)\\] \\[(?P<module>.*?)\\] (?P<message>.*)$"
    }

    // 2. Zeitstempel parsen
    // Hinweis: Das Komma bei den Millisekunden muss im Format beachtet werden
    stage.timestamp {
        source = "time"
        format = "2006-01-02 15:04:05,000"
    }

    // 3. Labels setzen
    stage.labels {
        values = {
            level  = "level",
            module = "module",
        }
    }

    // 4. Den eigentlichen Log-Text sauber anzeigen
    stage.output {
        source = "message"
    }

    forward_to = [loki.write.local.receiver]
}