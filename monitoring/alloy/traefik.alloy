local.file_match "traefik_logs" {
    path_targets = [
        {
            __path__="/var/docker_logs/traefik/traefik.log",
            job = "traefik",
            service="traefik",
        },
        {
             __path__="/var/docker_logs/traefik/access*.log",
             job = "traefik_access",
             service="traefik",
        },
    ]
}

loki.source.file "traefik_logs" {
    targets = local.file_match.traefik_logs.targets
    forward_to = [loki.write.local.receiver]
}