// 1. METRIKEN: Node-Exporter abfragen
discovery.relabel "metrics_filter" {
  targets = [
    {"__address__" = "node-exporter:9100", "job" = "node-exporter"},
  ]
}

prometheus.scrape "scrape_metrics" {
  targets    = discovery.relabel.metrics_filter.output
  forward_to = [prometheus.remote_write.local.receiver]
}

// --- NEU FÜR DASHBOARD 13639: Container-Metriken ---
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"

  // Diese Einstellungen helfen, dass die Labels im Dashboard
  // sauber erkannt werden (Name des Containers statt ID)
  storage_duration = "5m"
}

prometheus.scrape "cadvisor" {
  targets    = prometheus.exporter.cadvisor.docker.targets
  forward_to = [prometheus.remote_write.local.receiver]
}
// ---------------------------------------------------

// 2. LOGS: Docker-Container finden und Logs lesen
discovery.docker "docker_containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.docker_containers.targets
  forward_to = [loki.write.local.receiver]
}

// 3. ZIELE: Wohin mit den Daten?
prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}