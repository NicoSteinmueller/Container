# Linkwarden example environment
# Copy this file to `compose.prod.env` or export these variables in your environment.

# NextAuth secret (used to sign auth tokens)
NEXTAUTH_SECRET=changeme

# MeiliSearch master key
MEILI_MASTER_KEY=changeme

# Postgres password for the Linkwarden database
POSTGRES_PASSWORD=changeme

# Optional: Keycloak client secret
KEYCLOAK_CLIENT_SECRET=changeme
