#
# step-ca - die interne CA des Clusters.
#
# Sie stellt zwei Sorten Zertifikate aus, beide mit ${cert_lifetime} Laufzeit:
#
#   - das Client-Zertifikat der Edge-VM (edge1.dmz). Die Edge holt es sich
#     einmalig mit einem Token und erneuert danach über mTLS mit dem noch
#     gültigen Zertifikat - auf der Edge liegt deshalb nie ein
#     Provisioner-Passwort.
#   - das Serverzertifikat von ingress-public. Das holt sich der
#     Init-Container von Traefik selbst (values/traefik-public.yaml.tftpl).
#
# Warum so kurze Laufzeiten: Eine step-ca-Instanz stellt keine CRL aus, und
# Traefiks clientAuth prüft ohnehin keine Revokation. Ein erbeutetes
# Zertifikat bliebe sonst bis zum Ablauf gültig - auch nachdem die VM längst
# neu ausgerollt wurde. Ablauf ersetzt Rückruf (Entscheidung E5).
#
# `step ca init` setzt genau diese Werte als Default (min 5m, default 24h,
# max 24h). Wer längere Zertifikate braucht, ändert die Claims - und sollte
# vorher E5 noch einmal lesen.
#
fullnameOverride: step-ca

ca:
  name: Homelab Internal CA
  address: ":9000"

  #
  # Die Namen, für die das Serverzertifikat der CA gilt. Beide werden
  # gebraucht:
  #   ${service_fqdn} - aus dem Cluster (ingress-public)
  #   ${node_dmz_ip}  - von der Edge-VM, die über TCP-Passthrough auf
  #                     ingress-public an dieser IP landet und dort keinen
  #                     Namen, sondern die Adresse verwendet
  #
  dns: "${service_fqdn},step-ca,${node_dmz_ip},127.0.0.1"

  # Landet in defaults.json im CA-Pod. Ohne Portangabe würde `step` dort
  # https://.../:443 annehmen - der Service lauscht aber auf 9000.
  url: "https://${service_fqdn}:9000"

  # Verschlüsselt die CA-Schlüssel auf der Platte. Der Schlüssel selbst
  # entsteht im Cluster und verlässt diesen Namespace nicht.
  password: "${ca_password}"

  provisioner:
    name: homelab
    password: "${provisioner_password}"

  db:
    enabled: true
    persistent: true
    storageClass: local-path
    size: 1Gi

  ssh:
    # Kein SSH-CA-Betrieb: Es gibt keine Maschine im Aufbau, die sich per SSH
    # gegen eine CA authentifizieren würde. Talos hat keinen SSH-Server, und
    # die Edge-VM verwendet Public Keys.
    enabled: false

#
# Erreichbar ist die CA über zwei Wege:
#   - clusterintern über diesen Service
#   - von der Edge-VM über ingress-public, Port ${node_dmz_ip}:9000 als
#     TCP-Passthrough (charts/homelab-policies). Passthrough, weil die Edge
#     beim Bootstrap den Fingerprint des Wurzelzertifikats prüft - eine
#     terminierende Zwischenstation würde genau diese Prüfung aushebeln.
#
service:
  type: ClusterIP
  port: 9000
  targetPort: 9000

#
# Ohne diese Requests läuft step-ca als BestEffort - die QoS-Klasse, die der
# Kubelet bei Speicherdruck zuerst opfert und die bei CPU-Konkurrenz als letzte
# bedient wird. Für die interne CA ist das die falsche Einstufung: Hängt sie,
# bekommt die Edge-VM kein Client-Zertifikat mehr, und nach spätestens 24 h
# steht die gesamte öffentliche Strecke.
#
# Der Anlass war konkret. Das Chart verdrahtet seine Probes fest, ohne
# Stellschraube, und übernimmt damit die Kubernetes-Voreinstellung
# timeoutSeconds: 1 - eine Sekunde für einen kompletten TLS-Handshake. Im
# Normalbetrieb antwortet /health in Mikrosekunden; unter Last reichte die
# Sekunde nicht, die Liveness-Probe schlug fehl und step-ca ging in
# CrashLoopBackOff:
#
#   Liveness probe failed: Get "https://10.244.0.211:9000/health":
#     context deadline exceeded
#
# Da die Probe selbst nicht einstellbar ist, wird stattdessen der Grund für die
# Verzögerung beseitigt: Mit Requests ist der Pod Burstable statt BestEffort
# und bekommt seinen Anteil garantiert.
#
resources:
  requests:
    cpu: 50m
    memory: 128Mi

# Der Chart-Job legt Wurzel, Intermediate und den Provisioner beim ersten
# Release an und schreibt sie in ConfigMaps und Secrets dieses Namespaces.
bootstrap:
  enabled: true

inject:
  enabled: false
