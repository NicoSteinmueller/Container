#
# CrowdSec im Cluster: LAPI und Agent.
#
# Die Aufteilung aus dem Konzept:
#
#   Agent (Proxy-Logs)  Edge-VM   404-Stürme, CVE-Scans, 401-Muster
#   Agent (App-Logs)    hier      Nextcloud-Loginfehler, Paperless
#   LAPI                hier      sammelt Alarme, hält die Sperrliste
#   Firewall-Bouncer    Edge-VM   setzt nftables-Regeln
#
# Die LAPI gehört hierher, weil die Edge die Komponente mit Internetkontakt
# ist. Läge die Entscheidungsdatenbank dort, könnte ein Angreifer die
# Sperrliste löschen, die ihn blockiert (E7).
#
# Alle Verbindungen laufen in dieselbe Richtung - Edge -> Cluster. Es braucht
# keine Freigabe vom Cluster in die DMZ.
#

# Talos verwendet containerd; mit dem Docker-Default würden die Logzeilen
# nicht geparst.
container_runtime: containerd

lapi:
  enabled: true
  replicas: 1

  env:
    # Der LAPI-Pod ist die Entscheidungsdatenbank, kein Log-Leser.
    - name: DISABLE_AGENT
      value: "true"

  #
  # Beides muss einen Neustart überleben:
  #   config - die Zugangsdaten der registrierten Maschinen und Bouncer.
  #            Ohne Persistenz müssten Edge-Agent und beide Bouncer nach
  #            jedem Pod-Neustart neu registriert werden.
  #   data   - die Sperrliste selbst.
  #
  persistentVolume:
    config:
      enabled: true
      storageClassName: local-path
      size: 100Mi
    data:
      enabled: true
      storageClassName: local-path
      size: 1Gi

  service:
    type: ClusterIP

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 256Mi

agent:
  enabled: true

  env:
    - name: COLLECTIONS
      value: "${join(" ", collections)}"

  #
  # Was der Agent liest. Das ist der Teil, den die Proxy-Logs der Edge-VM
  # nicht leisten können: Ein fehlgeschlagener Nextcloud-Login über das
  # Webformular liefert HTTP 200, weil einfach die Loginseite mit
  # Fehlermeldung neu gerendert wird - aus Proxy-Sicht sieht Bruteforce aus
  # wie normales Surfen. Nur WebDAV mit Basic-Auth liefert 401.
  #
  # podName ist ein Präfix-Muster und geht davon aus, dass die Pods eines
  # Dienstes so heißen wie ihr Namespace. Sobald die Anwendungen stehen,
  # dagegen prüfen - eine Acquisition, die auf nichts passt, meldet keinen
  # Fehler, sie bleibt einfach still:
  #   kubectl -n crowdsec exec ds/crowdsec-agent -- cscli metrics
  #
  acquisition:
%{ for ns in app_namespaces ~}
    - namespace: ${ns.name}
      podName: ${ns.name}-*
      program: ${ns.name}
%{ endfor ~}

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      memory: 256Mi

config:
  #
  # Profile werden von oben nach unten ausgewertet; das erste mit
  # `on_success: break` gewinnt.
  #
  profiles.yaml: |
    #
    # 1. Die eigenen Adressen werden nie gesperrt.
    #
    # Bewusst als Profil und nicht als Whitelist im Agenten: Eine Whitelist
    # greift nur dort, wo der Alarm entsteht. Alarme kommen hier aber auch
    # von außerhalb des Clusters - vom Agenten auf der Edge-VM. Wer die Edge
    # übernimmt, kann Alarme für beliebige IPs melden, auch für die eigene
    # Verwaltungsadresse. Ein Profil an dieser Stelle kann davon nicht
    # überschrieben werden.
    #
    name: homelab_whitelist
    filters:
      - Alert.GetScope() == "Ip" && (${join(" || ", [for src in whitelist_sources : "IpInRange(Alert.GetValue(), \"${src}\")"])})
    decisions: []
    on_success: break
    ---
    #
    # 2. Alarme vom Agenten der Edge-VM zählen weniger.
    #
    # Der Edge-Agent hat Machine-Credentials und darf per Definition Alarme
    # schreiben. Damit existiert vom exponierten Netz aus ein
    # authentifizierter Schreibpfad in die Entscheidungsdatenbank der
    # vertrauten Zone. Das lässt sich nicht schließen, ohne die Erkennung auf
    # der Edge aufzugeben - aber es lässt sich gewichten: kürzere Sperren,
    # damit ein missbrauchter Edge-Agent keine dauerhaften Sperren erzeugt.
    #
    # Alert.Remediation == true gehört auch hier in den Filter, und zwar aus
    # demselben Grund wie unten: Ohne diese Bedingung würde das Profil auch
    # auf Alarme greifen, für die das Szenario gar keine Sperre vorsieht -
    # ausgerechnet für die Maschine, der weniger vertraut werden soll, wäre
    # es damit großzügiger als das Standardprofil.
    #
    # Beim Scharfschalten einmal gegenprüfen, dass der Filter tatsächlich
    # greift - ein Ausdruck, der nie zutrifft, fällt sonst nicht auf:
    #   cscli alerts list --machine ${edge_machine_id}
    #   cscli decisions list        # Dauer der Einträge von dieser Maschine
    #
    name: edge_agent_lower_trust
    filters:
      - Alert.Remediation == true && Alert.GetScope() == "Ip" && Alert.MachineID == "${edge_machine_id}"
    decisions:
      - type: ban
        duration: 1h
    on_success: break
    ---
    #
    # 3. Alles Übrige: die Alarme der Agenten im Cluster.
    #
    name: default_ip_remediation
    filters:
      - Alert.Remediation == true && Alert.GetScope() == "Ip"
    decisions:
      - type: ban
        duration: 4h
    on_success: break

  #
  # Die Konsole von CrowdSec (app.crowdsec.net) bleibt außen vor: Sie würde
  # Alarme mit Adressdaten aus dem eigenen Netz an einen Dritten melden.
  # Die Community-Blocklist wird davon unabhängig weiter bezogen.
  #
  console.yaml: |
    share_manual_decisions: false
    share_tainted: false
    share_custom: false
    share_context: false
