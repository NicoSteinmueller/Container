#
# Der Genehmiger für die Serverzertifikate des Kubelets.
#
# Er gehört zu serverTLSBootstrap in vm/talos/patches/hardening.yaml und ist
# ohne diesen wirkungslos - und umgekehrt: serverTLSBootstrap ohne diesen
# Dienst legt den Node lahm. Die Warnung steht dort ausführlich; kurz:
#
#   Mit serverTLSBootstrap fordert das Kubelet sein Serverzertifikat über
#   einen CSR an, statt sich eines selbst zu unterschreiben. Genehmigt den
#   CSR niemand, bleibt er "Pending" - und damit funktionieren `kubectl logs`,
#   `kubectl exec` und jeder Metrikabruf nicht mehr.
#
# Deshalb die Reihenfolge: erst dieser Dienst, dann der Talos-Patch. So
# herum gibt es kein Zeitfenster, in dem der Node ohne Serverzertifikat
# dasteht.
#
# Warum postfinance/kubelet-csr-approver und nicht der in der Talos-Doku
# genannte alex1989hu/kubelet-serving-cert-approver: Letzterer wird als
# fertiges YAML von einer URL angewendet, was hier keinen Ort hätte - alles
# andere in diesem Cluster ist eine gepinnte Helm-Release, die Renovate
# verfolgen kann. Der Unterschied im Verhalten ist zudem einer, der zu diesem
# Setup passt: Dieser hier genehmigt nicht pauschal, sondern prüft, ob die
# Namen und Adressen im CSR zu dem passen, was unten steht.
#

#
# Ein Node, eine Instanz. Die Voreinstellung des Charts ist 2 mit
# Leader-Election - auf einem Ein-Node-Cluster bliebe der zweite Pod dauerhaft
# Pending, und die Anzeige sähe nach einem Fehler aus, der keiner ist.
#
replicas: 1
leaderElection: false

#
# Der Zuschnitt, der aus "genehmigt alles" eine Prüfung macht.
#
# Ein CSR wird nur genehmigt, wenn sein DNS-Name auf diesen Ausdruck passt
# und seine IP-Adressen in den Präfixen unten liegen. Der Anker an beiden
# Enden ist wichtig: ohne ^ und $ würde "homelab-cp1.angreifer.example"
# ebenfalls passen.
#
# ${node_name} ist der Hostname aus vm/talos/patches/network.yaml.tftpl - er
# wird zum Node-Namen und taucht genau so im CSR des Kubelets wieder auf.
#
providerRegex: ^${node_name}$

#
# Die Adressen, die im Zertifikat stehen dürfen: nur die LAN-Adresse.
#
# Der Node hat zwei Beine, aber machine.kubelet.nodeIP.validSubnets in
# vm/talos begrenzt die Node-IP auf das Heimnetz - die DMZ-Adresse steht
# nicht im Node-Objekt und gehört deshalb auch nicht in ein Kubelet-
# Zertifikat. Stünde sie hier, wäre die Einschränkung dort wieder aufgehoben.
#
providerIpPrefixes:
  - ${node_lan_ip}/32

#
# Ohne DNS-Auflösung prüfen.
#
# Die Prüfung schlägt sonst normalerweise fehl: Sie erwartet, dass sich
# "${node_name}" per DNS auflösen lässt und auf die Adresse im CSR zeigt. Im
# Heimnetz gibt es dafür keinen Eintrag - der Node heißt so nur innerhalb von
# Kubernetes.
#
# Das ist vertretbar, weil die Prüfung damit nicht entfällt, sondern die
# Grundlage wechselt: Statt DNS entscheiden providerRegex und
# providerIpPrefixes oben, und die sind auf genau einen Namen und genau eine
# Adresse festgelegt. Bei einem Cluster mit wechselnden Nodes wäre die
# Abwägung eine andere.
#
bypassDnsResolution: true

#
# Nur CSRs vom Kubelet, nicht von beliebigen Antragstellern. Ein CSR, dessen
# Username nicht mit system:node: beginnt, wird ignoriert statt abgelehnt -
# so kommt sich dieser Dienst mit keinem anderen Genehmiger ins Gehege.
#
ignoreNonSystemNode: true

#
# Ein Node, ein Name. Die Voreinstellung ist ohnehin 1; ausdrücklich, weil ein
# CSR mit mehreren DNS-Namen bei einem einzelnen Kubelet nichts Gutes bedeutet.
#
allowedDnsNames: 1

#
# Laufzeit der Kubelet-Zertifikate. Die Voreinstellung des Charts sind 367
# Tage; das Kubelet erneuert von sich aus deutlich häufiger, und eine kurze
# Obergrenze kostet hier nichts.
#
maxExpirationSeconds: "${max_expiration_seconds}"

metrics:
  enable: false

resources:
  requests:
    cpu: 10m
    memory: 32Mi
  limits:
    memory: 64Mi
