#
# ingress-internal - Paperless und die Verwaltungsoberflächen.
#
# Getrennter Controller statt getrennter Konfiguration (Entscheidung E6):
# Trennung nach Erreichbarkeit, nicht nach Einstellung. Er lauscht
# ausschließlich auf ${node_lan_ip} und ist damit aus dem Internet
# unerreichbar - die Fritzbox reicht nur 443 an die Edge-VM weiter, und die
# kennt nur die DMZ-Adresse des Nodes.
#
# Kein Client-Zertifikat, keine WAF, kein CrowdSec-Bouncer: Die
# Vertrauensgrenze ist hier das Heimnetz. Wer im LAN steht, hat ohnehin mehr
# Wege als diesen.
#

deployment:
  kind: Deployment
  replicas: 1
  # Sonst erbt der Pod bei hostNetwork /etc/resolv.conf des Nodes und kennt
  # kein .svc.cluster.local mehr.
  dnsPolicy: ClusterFirstWithHostNet

podSecurityContext:
  runAsUser: 65532
  runAsGroup: 65532
  runAsNonRoot: true
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL
    # Kein NET_BIND_SERVICE: Es hilft einem Nicht-Root-Prozess ohne
    # File-Capability nicht über den execve hinweg. Dass dieser Controller 80
    # und 443 als UID 65532 binden darf, kommt vom Sysctl
    # net.ipv4.ip_unprivileged_port_start=0 auf dem Node - ausführlich in
    # traefik-public.yaml.tftpl und vm/talos/patches/hardening.yaml.
    add: []

#
# Netz-Namespace des Nodes statt Pod-Netz. Ausführlich begründet in
# traefik-public.yaml.tftpl; kurz: Das Chart schreibt `hostIP` auch in die
# Entrypoint-Adresse, und im Pod-Netz gibt es ${node_lan_ip} nicht. Ohne
# hostIP wiederum kollidieren die beiden Ingress-Controller auf Port 443.
#
hostNetwork: true

#
# Recreate statt RollingUpdate - sonst blockiert sich jedes Upgrade selbst.
#
# Mit hostNetwork behandelt der Scheduler die containerPorts wie Node-Ports.
# Der Node hat aber nur einen Satz davon, und die Chart-Voreinstellung ist
# maxUnavailable: 0 / maxSurge: 1: Der neue Pod soll starten, BEVOR der alte
# geht - und bleibt dann Pending mit
#
#   0/1 nodes are available: 1 node(s) didn't have free ports for the
#   requested pod ports
#
# waehrend der alte auf den neuen wartet. Ein Deadlock, der erst beim naechsten
# Upgrade auffaellt und wie ein Scheduling-Problem aussieht.
#
# Der Preis ist eine kurze Luecke beim Rollout. Bei einem Ingress auf einem
# Ein-Node-Cluster ist die ohnehin unvermeidbar.
#
updateStrategy:
  type: Recreate
  rollingUpdate: null

#
# Mit hostNetwork ist `port` zugleich der Port auf dem Node - hostPort
# entfällt. Jeder Port braucht ein hostIP, auch die internen: Beide
# Controller teilen sich den Netz-Namespace, und zwei Prozesse auf
# 0.0.0.0:8080 schließen einander aus.
#
ports:
  traefik:
    port: 8080
    hostIP: ${node_lan_ip}
    expose:
      default: false

  metrics:
    port: 9100
    hostIP: ${node_lan_ip}
    expose:
      default: false

  web:
    port: 80
    hostIP: ${node_lan_ip}
    expose:
      default: false
    # Nur zum Weiterleiten. Ein Passwortfeld auf einer unverschlüsselten
    # Verbindung im eigenen LAN ist immer noch ein Passwortfeld auf einer
    # unverschlüsselten Verbindung.
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    port: 443
    hostIP: ${node_lan_ip}
    expose:
      default: false
    http:
      tls:
        enabled: true
    forwardedHeaders:
      # Vor diesem Controller steht kein Proxy. Ein vom Client gesetzter
      # X-Forwarded-For darf hier deshalb niemals geglaubt werden - er würde
      # in den Logs der Anwendungen als echte Herkunft auftauchen.
      trustedIPs: []
      insecure: false

service:
  enabled: false

rbac:
  enabled: true
  namespaced: true

ingressClass:
  enabled: false

providers:
  kubernetesIngress:
    enabled: true
    ingressClass: internal
    allowExternalNameServices: false
    namespaces:
%{ for ns in watch_namespaces ~}
      - ${ns}
%{ endfor ~}

  kubernetesCRD:
    enabled: true
    allowCrossNamespace: false
    allowExternalNameServices: false
    namespaces:
%{ for ns in watch_namespaces ~}
      - ${ns}
%{ endfor ~}

  kubernetesGateway:
    enabled: false

#
# Das Dashboard bleibt auch hier aus. Es kennt keine Authentifizierung, und
# "nur im LAN erreichbar" ist keine.
#
ingressRoute:
  dashboard:
    enabled: false
  healthcheck:
    enabled: false

log:
  level: INFO

accessLog:
  enabled: true
  format: json

resources:
  requests:
    cpu: 50m
    memory: 96Mi
  limits:
    memory: 192Mi
