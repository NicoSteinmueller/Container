#
# ingress-internal - Paperless und die Verwaltungsoberflächen.
#
# Getrennter Controller statt getrennter Konfiguration (Entscheidung E6):
# Trennung nach Erreichbarkeit, nicht nach Einstellung. Er lauscht
# ausschließlich auf ${node_lan_ip} und ist damit aus dem Internet
# unerreichbar - die Fritzbox reicht nur 443 an die Edge-VM weiter, und die
# kennt nur die DMZ-Adresse des Nodes.
#
# Kein Client-Zertifikat, keine WAF, kein CrowdSec-Bouncer: Die
# Vertrauensgrenze ist hier das Heimnetz. Wer im LAN steht, hat ohnehin mehr
# Wege als diesen.
#

deployment:
  kind: Deployment
  replicas: 1

podSecurityContext:
  runAsUser: 65532
  runAsGroup: 65532
  runAsNonRoot: true
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL

ports:
  traefik:
    port: 8080
    expose:
      default: false

  web:
    port: 8000
    hostPort: 80
    hostIP: ${node_lan_ip}
    expose:
      default: false
    # Nur zum Weiterleiten. Ein Passwortfeld auf einer unverschlüsselten
    # Verbindung im eigenen LAN ist immer noch ein Passwortfeld auf einer
    # unverschlüsselten Verbindung.
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    port: 8443
    hostPort: 443
    hostIP: ${node_lan_ip}
    expose:
      default: false
    http:
      tls:
        enabled: true
    forwardedHeaders:
      # Vor diesem Controller steht kein Proxy. Ein vom Client gesetzter
      # X-Forwarded-For darf hier deshalb niemals geglaubt werden - er würde
      # in den Logs der Anwendungen als echte Herkunft auftauchen.
      trustedIPs: []
      insecure: false

service:
  enabled: false

rbac:
  enabled: true
  namespaced: true

ingressClass:
  enabled: false

providers:
  kubernetesIngress:
    enabled: true
    ingressClass: internal
    allowExternalNameServices: false
    namespaces:
%{ for ns in watch_namespaces ~}
      - ${ns}
%{ endfor ~}

  kubernetesCRD:
    enabled: true
    allowCrossNamespace: false
    allowExternalNameServices: false
    namespaces:
%{ for ns in watch_namespaces ~}
      - ${ns}
%{ endfor ~}

  kubernetesGateway:
    enabled: false

#
# Das Dashboard bleibt auch hier aus. Es kennt keine Authentifizierung, und
# "nur im LAN erreichbar" ist keine.
#
ingressRoute:
  dashboard:
    enabled: false
  healthcheck:
    enabled: false

log:
  level: INFO

accessLog:
  enabled: true
  format: json

resources:
  requests:
    cpu: 50m
    memory: 96Mi
  limits:
    memory: 192Mi
