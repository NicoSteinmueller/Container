#
# Cilium für den Talos-Node - wird von main.tf über `helm template` gerendert
# und als Inline-Manifest in die Machine-Config gelegt.
#
# Warum Inline-Manifest und nicht `helm install` nach dem Bootstrap: Ohne CNI
# bleibt der Node NotReady, und dann kann `terraform apply` nicht auf einen
# gesunden Cluster warten - es käme ein halb fertiger Cluster als Erfolg
# zurück. Als Teil der Machine-Config gehört das CNI zur Maschine, nicht zur
# Anwendungsschicht.
#

#
# Talos-spezifisch, siehe
# https://www.talos.dev/latest/kubernetes-guides/network/deploying-cilium/
#
# Talos mountet cgroup v2 selbst und lässt Cilium nicht mit einem
# privilegierten Init-Container daran arbeiten - deshalb kein autoMount,
# sondern der Pfad des Hosts, und ein explizit aufgezählter Capability-Satz
# statt "privileged".
#
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE

#
# kube-proxy-Replacement. Talos startet den Cluster deshalb ohne kube-proxy
# (cluster.proxy.disabled in patches/cluster.yaml.tftpl) - beides gehört
# zusammen, sonst behandeln zwei Datapfade dieselben Services.
#
# Nebeneffekt, auf den später ein Ingress-Controller baut: Ohne kube-proxy
# übernimmt Cilium auch hostPort, und zwar mit Beachtung von hostIP.
#
kubeProxyReplacement: true

#
# KubePrism: der clusterinterne Endpoint der Kubernetes-API auf localhost
# (machine.features.kubePrism in patches/node.yaml.tftpl). Bewusst statt der
# Node-IP - so hängt Cilium nicht an einer Adresse, die sich mit dem Netz
# ändert, und der Weg zur API verlässt den Node nicht.
#
k8sServiceHost: localhost
k8sServicePort: 7445

#
# Adressen für Pods kommen aus dem podSubnet der Machine-Config, verteilt über
# die PodCIDR des Nodes.
#
ipam:
  mode: kubernetes

# Ein Node, ein Operator. Der Default (2 Replicas mit Anti-Affinity) ließe
# einen Pod dauerhaft Pending.
#
# Die Requests sind nicht kosmetisch. Ohne sie ist der Operator `BestEffort`,
# und `BestEffort` ist die Klasse, die Talos' OOM-Controller bei Speichernot
# zuerst abräumt.
# Der Operator verliert dabei seine Leader-Lease und startet neu, was bei
# ohnehin knappem Speicher genau die Last erzeugt, die den nächsten Kill
# auslöst. Gemessener Bedarf: 21m / 61Mi.
operator:
  replicas: 1
  rollOutPods: true
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
  # Metriken auf :9963 (siehe `prometheus` weiter unten).
  prometheus:
    enabled: true

rollOutCiliumPods: true

#
# L7-Policies und Sichtbarkeit.
#
# Hubble-Relay und -UI bleiben ab Werk aus: Das RAM-Budget ist knapp, und
# `hubble observe` funktioniert auch ohne Relay direkt im Agent-Pod:
#   kubectl -n kube-system exec ds/cilium -- hubble observe --follow
#
# l7Proxy bringt seit 1.16 ein eigenes DaemonSet `cilium-envoy` mit - ein Pod
# mehr auf dem Node, dafür überlebt der Proxy einen Neustart des Agents.
#
l7Proxy: true

# Aus demselben Grund wie beim Operator oben: sonst `BestEffort`, und damit
# erstes Opfer des OOM-Controllers. Beim Envoy wiegt das schwerer als beim
# Operator - er sitzt im Datenpfad jeder L7-Policy. Gemessener Bedarf:
# 8m / 42Mi.
envoy:
  resources:
    requests:
      cpu: 25m
      memory: 96Mi
  # Metriken auf :9964 (siehe `prometheus` weiter unten).
  prometheus:
    enabled: true

hubble:
  enabled: true
  relay:
    enabled: ${hubble_relay_enabled}
  ui:
    enabled: ${hubble_ui_enabled}

  #
  # Hubble-Metriken auf :9965 - was Hubble an Flows sieht, als Zähler für
  # Prometheus (siehe `prometheus` weiter unten). Kontext je Metrik so gewählt,
  # dass sich Blockiertes einem Namespace und Workload zuordnen lässt:
  #
  #   dns     Abfragen mit Name (`query`); AAAA ausgelassen (doppelte
  #           Zählung). Vom DNS-Proxy abgelehnte fehlen hier - dafür `export`
  #   drop    verworfene Pakete mit Grund, Quelle und Ziel
  #   flow    Verkehr je Namespace-Paar
  #   policy  Policy-Entscheidungen (erlaubt/verweigert) je Quelle und Ziel
  #   tcp     TCP-Flags (Resets, SYN ohne Antwort)
  #
  # `query` im dns-Zähler kostet Kardinalität: eine Zeitreihe je Name und
  # Namespace, Suchdomänen-Varianten eingeschlossen. Bei einem Node ist das
  # vertretbar; wächst der Cluster, `query` wieder weglassen.
  #
  metrics:
    enabled:
      - dns:query;ignoreAAAA;labelsContext=source_namespace,source_workload
      - drop:labelsContext=source_namespace,source_workload,destination_namespace,destination_workload
      - flow:labelsContext=source_namespace,destination_namespace
      - policy:sourceContext=app|workload-name|pod|reserved-identity;destinationContext=app|workload-name|pod|dns|reserved-identity;labelsContext=source_namespace,destination_namespace
      - tcp

  #
  # Abgelehnte DNS-Abfragen als Flow-Log - für die Namen, die keine Metrik
  # führt: Ein vom DNS-Proxy abgelehnter Name taucht weder in `hubble_dns_*`
  # noch in `hubble_drop_total` auf, nur als L7-Flow mit Verdict DROPPED
  # (nachgemessen).
  #
  # `stdout` statt Datei: Die Zeilen landen im Log des Agents, und Alloy trägt
  # sie mit den übrigen Pod-Logs nach Loki - ohne weiteren hostPath. Nur
  # Ablehnungen und nur die Felder für das Dashboard „DNS-Blockaden“; ein Pod,
  # der einen gesperrten Namen in Schleife fragt, schreibt eine Zeile je
  # Versuch.
  #
  export:
    static:
      enabled: true
      filePath: stdout
      allowList:
        - '{"verdict":["DROPPED"],"protocol":["dns"]}'
      fieldMask:
        - time
        - verdict
        - source.namespace
        - source.pod_name
        - source.workloads
        - l7.dns.query
        - l7.dns.qtypes

  #
  # Zertifikate für Hubble dürfen nicht beim Rendern entstehen.
  #
  # Ab Werk erzeugt das Chart eine eigene CA samt Server-Zertifikaten - und
  # zwar bei *jedem* `helm template`. Weil das Chart hier als Inline-Manifest
  # in die Machine-Config gerendert wird, ändert sich damit die Machine-Config
  # bei jedem Lauf: `terraform plan` meldet ewig eine Änderung, und jedes
  # `terraform apply` schiebt dem Cluster eine neue CA unter und startet Cilium
  # neu. Ein Plan, der nie leer wird, ist außerdem kein brauchbarer
  # Drift-Nachweis mehr - man sieht echte Abweichungen nicht.
  #
  # Solange Relay und UI aus sind, spricht niemand über das Netz mit der
  # Hubble-API; sie ist nur im Agent-Pod erreichbar. Dann braucht es dort auch
  # kein TLS.
  #
  # Wird Relay eingeschaltet, geht TLS mit an - dann aber über `cronJob`: Die
  # Zertifikate entstehen im Cluster zur Laufzeit statt hier beim Rendern, die
  # Machine-Config bleibt stabil.
  #
  tls:
    enabled: ${hubble_relay_enabled}
    auto:
      enabled: ${hubble_relay_enabled}
      method: cronJob

#
# LoadBalancer-IPAM und L2-Announcements. Damit bekommen die Ingress-Controller
# je eine eigene LAN-Adresse, statt sich über hostPort die Node-Adresse zu
# teilen - und ohne hostPort entfällt hostNetwork, und damit der Sysctl
# `net.ipv4.ip_unprivileged_port_start=0`. Die Adressbereiche selbst stehen
# nicht hier, sondern als CiliumLoadBalancerIPPool in
# k8s/flux/network/lb-ipam/.
#
# LB-IPAM (die Vergabe) braucht kein Flag - es genügt, dass ein IPPool
# existiert. Eingeschaltet wird hier nur die *Ankündigung* im Netz.
#
# `l2announcements.enabled` setzt zweierlei, und beides wird gebraucht: das
# Agent-Flag `enable-l2-announcements` und die RBAC-Regeln auf
# `coordination.k8s.io/leases`. Wer nur das Flag setzt - etwa per
# `kubectl patch cm cilium-config` -, bekommt einen Agent, der ankündigen will
# und nicht darf: eine Endlosschleife aus
# `leases.coordination.k8s.io ... is forbidden` im Log und keine einzige
# Ankündigung. Der Weg führt deshalb über diese Werte, nicht über die
# ConfigMap.
#
# Dass Gratuitous ARP für eine Zusatzadresse über das macvtap-Interface des
# Nodes durchgeht, ist nachgemessen: Vom Unraid-Host aus trägt die
# LB-Adresse dieselbe MAC wie die Node-Adresse. Vorgehen in
# k8s/INBETRIEBNAHME.md, Schritt 4.
#
l2announcements:
  enabled: true

# Die L2-Announcements arbeiten mit Leases; die Cilium-Doku empfiehlt dafür ein
# höheres Client-Limit, sonst drosselt der Agent sich selbst.
k8sClientRateLimit:
  qps: 20
  burst: 40

#
# Metriken des Agents auf :9962. Gescrapt von Prometheus über PodMonitors in
# k8s/flux/observability-rules/CiliumPodMonitors.yaml - keine ServiceMonitors
# aus dem Chart: Das Chart wird als Inline-Manifest beim Bootstrap angewendet,
# lange bevor kube-prometheus-stack die CRDs dafür mitbringt.
#
# Alle vier Ports liegen im Host-Netz des Nodes und sind nur aus dem
# Pod-Netz erreichbar (patches/firewall.yaml.tftpl, Regel cilium-metrics).
#
prometheus:
  enabled: true

# Ressourcen: Reservierung statt Limit. Ein gedrosseltes CNI ist ein schwer zu
# diagnostizierender Fehler im gesamten Cluster.
resources:
  requests:
    cpu: 100m
    memory: 256Mi
