#
# Clusterweite Einstellungen: Netz, CNI, kube-proxy, etcd.
#
cluster:
  #
  # Ein-Node-Cluster: Ohne diesen Schalter trägt Talos den NoSchedule-Taint auf
  # die Control Plane und es gäbe keinen Node für Workloads. Kommen später
  # Worker dazu, gehört die Zeile wieder weg.
  #
  allowSchedulingOnControlPlanes: true

  network:
    podSubnets:
      - ${pod_subnet}
    serviceSubnets:
      - ${service_subnet}

    #
    # Kein Flannel: Cilium kommt als Inline-Manifest (siehe main.tf).
    # Das Konzept verlangt NetworkPolicies inklusive L7 - Flannel kann keine.
    #
    cni:
      name: none

  #
  # Kein kube-proxy. Cilium übernimmt Services im eBPF-Datapath und damit auch
  # hostPort mit hostIP - die Grundlage dafür, dass ingress-public
  # ausschließlich auf ${node_dmz_ip} und ingress-internal ausschließlich auf
  # ${lan_ip} lauscht.
  #
  proxy:
    disabled: true

  etcd:
    #
    # etcd annonciert sich nur im LAN-Segment. Ohne diese Einschränkung sucht
    # es sich bei zwei Beinen eine Adresse aus - und im schlechteren Fall ist
    # das die DMZ-Adresse, also die Seite, auf der die exponierte VM steht.
    #
    advertisedSubnets:
      - ${lan_cidr}
    listenSubnets:
      - ${lan_cidr}

  apiServer:
    #
    # Die API ist über die LAN-Adresse erreichbar; das Serverzertifikat muss
    # den Namen enthalten, den kubeconfig und talosctl verwenden.
    #
    certSANs:
      - ${lan_ip}
      - 127.0.0.1

    #
    # PodSecurity-Admission clusterweit: "restricted" als Default für alles,
    # was sich nicht ausdrücklich ausnimmt. Talos setzt hier ab Werk
    # "baseline"; restricted ist die Stufe, die auch runAsNonRoot und
    # seccomp verlangt.
    #
    # Ausgenommen sind die Namespaces, die hostPort oder Host-Zugriff
    # brauchen - sie tragen ihr eigenes pod-security.kubernetes.io/enforce
    # Label (siehe k8s/platform/charts/homelab-base).
    #
    admissionControl:
      - name: PodSecurity
        configuration:
          apiVersion: pod-security.admission.config.k8s.io/v1
          kind: PodSecurityConfiguration
          defaults:
            enforce: "restricted"
            enforce-version: "latest"
            audit: "restricted"
            audit-version: "latest"
            warn: "restricted"
            warn-version: "latest"
          exemptions:
            usernames: []
            runtimeClasses: []
            namespaces:
              # Talos' eigene Control-Plane-Komponenten und Cilium laufen mit
              # hostNetwork und Host-Mounts - sie können die Regel nicht
              # erfüllen.
              - kube-system
