cluster:
  # Aus demselben Grund wie nodeIP im KubeNodeConfig (node.yaml.tftpl): etcd
  # soll sich weder unter der Tunnel-Adresse noch unter public_ip ankündigen
  etcd:
    advertisedSubnets:
      - ${lan_ip}/32
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
podSubnets:
  - ${pod_subnet}
serviceSubnets:
  - ${service_subnet}
---
#
# Kein kube-proxy. Cilium übernimmt Services im eBPF-Datapath
# (kubeProxyReplacement in values/cilium.yaml.tftpl) - beides gehört
# zusammen, sonst behandeln zwei Datapfade dieselben Services.
#
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
#
# Kein Flannel und keine Discovery: beides sind Dokumente, die Talos selbst
# anlegt, und sie zu entfernen steht in defaults.yaml.
#
