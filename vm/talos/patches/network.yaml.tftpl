#
# Netzwerk des Nodes - zwei Beine, statisch adressiert.
#
#   LAN (${lan_ip})  - Heimnetz hinter der Fritzbox. Hier hängen Talos-API,
#                      Kubernetes-API und ingress-internal. Nur hier steht ein
#                      Default-Gateway.
#   DMZ (${node_dmz_ip}) - isolierte Strecke zur Edge-VM. Kein Gateway, keine
#                      Route: In diesem Segment stehen genau zwei Maschinen,
#                      und der Node soll von dort aus nichts erreichen können,
#                      was nicht die Edge-VM ist.
#
# Zugeordnet wird über die MAC, nicht über den Interface-Namen: enp1s0/enp2s0
# hängen an der PCI-Reihenfolge und können sich beim nächsten Neuaufbau
# vertauschen. Dieselben MACs stehen in der libvirt-Domain (main.tf), beide
# Seiten kommen aus derselben Variablen.
#
# Kein DHCP: Die Adressen stehen in vm/edge (nftables-Regelsatz), in der
# Fritzbox-Freigabe und in der NetworkPolicy - eine geliehene Adresse wäre an
# drei Stellen falsch, sobald der Lease einmal nicht kommt.
#
machine:
  network:
    hostname: ${node_name}
    nameservers:
%{ for ns in dns_servers ~}
      - ${ns}
%{ endfor ~}

    interfaces:
      - deviceSelector:
          hardwareAddr: "${mac_lan}"
        addresses:
          - ${lan_ip}/${lan_prefix}
        routes:
          - network: 0.0.0.0/0
            gateway: ${lan_gateway}

      - deviceSelector:
          hardwareAddr: "${mac_dmz}"
        addresses:
          - ${node_dmz_ip}/${dmz_prefix}
        # Bewusst ohne routes: Das DMZ-Segment ist ein reines L2-Segment ohne
        # Gateway. Alles, was der Node ins Internet oder ins LAN schickt, geht
        # über das LAN-Bein.

  time:
    disabled: false
    servers:
%{ for ntp in ntp_servers ~}
      - ${ntp}
%{ endfor ~}

  kubelet:
    #
    # Die Node-IP ist die LAN-Adresse, nicht die DMZ-Adresse. Ohne diese
    # Festlegung würfelt das Kubelet bei zwei Beinen - und die Node-IP taucht
    # in etcd, in den Kubelet-Zertifikaten und als Default-Ziel für hostPort
    # ohne hostIP wieder auf.
    #
    nodeIP:
      validSubnets:
        - ${lan_cidr}

  features:
    #
    # KubePrism: lokaler Endpoint der Kubernetes-API auf 127.0.0.1:7445.
    # Cilium und alle hostNetwork-Komponenten sprechen darüber mit der API -
    # der Weg verlässt den Node nicht und überlebt einen Adresswechsel.
    #
    kubePrism:
      enabled: true
      port: 7445

    # apid prüft die ExtKeyUsage der Client-Zertifikate. Ohne das wäre ein
    # beliebiges von der Talos-CA signiertes Zertifikat auch ein gültiges
    # Admin-Zertifikat.
    apidCheckExtKeyUsage: true

    # Kein Weg von einem Pod zur Talos-API. Der Cluster darf die Maschine
    # nicht konfigurieren, auf der er läuft - das ist die Grenze, hinter die
    # ein Container-Escape nicht kommen soll.
    kubernetesTalosAPIAccess:
      enabled: false
