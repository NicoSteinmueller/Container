#
# Netzwerk und Identität des Nodes. Statisch adressiert: ${lan_ip}
# ist zugleich Kubernetes-API-Endpoint und steht in kubeconfig wie talosconfig
# - eine geliehene Adresse wäre dort falsch, sobald ein Lease ausbleibt.
#
# Was vom v1alpha1-Dokument übrig bleibt. Für die beiden Schalter gibt es noch
# kein eigenes Dokument.
#
machine:
  features:
    # apid prüft die ExtKeyUsage der Client-Zertifikate; sonst wäre jedes von
    # der Talos-CA signierte Zertifikat auch ein Admin-Zertifikat.
    apidCheckExtKeyUsage: true

  #
  # Kein Weg von einem Pod zur Talos-API: Es gibt bewusst kein
  # KubeTalosAPIAccessConfig-Dokument, und ohne es ist der Zugang zu. Der
  # Cluster darf die Maschine nicht konfigurieren, auf der er läuft.
  #
  # KubePrism (lokaler Endpoint der Kubernetes-API für hostNetwork-
  # Komponenten, 127.0.0.1:7445) bringt Talos als eigenes Dokument mit, in
  # der Voreinstellung genau so - hier steht dafür nichts mehr.
  #
%{ if public_ip != null ~}

  #
  # Zwei Beine im selben Netz. Ab Werk antwortet Linux auf jedem Bein per ARP
  # für jede Adresse des Nodes - die FRITZ!Box sähe ${lan_ip} dann auch unter
  # der MAC des public-Beins, und genau das soll das zweite Bein verhindern.
  #
  #   arp_ignore=1    antworten nur für Adressen auf dem Bein, auf dem die
  #                   Frage ankommt
  #   arp_announce=2  eigene ARP-Fragen tragen die Adresse des Beins, über
  #                   das sie hinausgehen
  #
  # `all`, nicht je Bein: Der Kernel-Name des public-Beins hängt an der
  # PCI-Position, und der Kernel nimmt ohnehin das Maximum aus `all` und Bein.
  #
  sysctls:
    net.ipv4.conf.all.arp_ignore: "1"
    net.ipv4.conf.all.arp_announce: "2"
%{ endif ~}
%{ if length(kernel_modules) > 0 ~}

  #
  # Eine Extension bringt Module mit, lädt sie aber nicht - das steht hier.
  # Gegenprobe: talosctl -n <node-ip> read /proc/modules
  #
  kernel:
    modules:
%{ for module in kernel_modules ~}
      - name: ${module}
%{ endfor ~}
%{ endif ~}
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ${node_name}
---
#
# Zugeordnet über die MAC statt über den Interface-Namen, der an der
# PCI-Reihenfolge hängt. Dieselbe MAC steht in der libvirt-Domain.
#
# permanent_addr statt der aktuellen Adresse: Die ist änderbar, die
# permanente nicht. virtio meldet beide gleich.
#
apiVersion: v1alpha1
kind: LinkAliasConfig
name: lan
selector:
  match: mac(link.permanent_addr) == "${lower(node_mac)}"
---
apiVersion: v1alpha1
kind: LinkConfig
name: lan
addresses:
  - address: ${lan_ip}/${lan_prefix}
routes:
  - gateway: ${lan_gateway}
%{ if public_ip != null ~}
---
#
# Das Bein von ingress-public: ${public_ip} mit eigener MAC, damit die
# FRITZ!Box die Adresse als eigenes Gerät führt und Ports dorthin freigibt.
# Die Adresse sitzt auf dem Bein selbst, nicht nur als L2-Announcement: Nur so
# fragt der Kernel von hier aus mit ihr als Absender nach dem Gateway, und die
# MAC trägt im LAN genau eine Adresse. Cilium bedient sie trotzdem als
# LoadBalancer-Adresse - der Service-Lookup im eBPF kommt vor dem Kernel.
#
apiVersion: v1alpha1
kind: LinkAliasConfig
name: public
selector:
  match: mac(link.permanent_addr) == "${lower(public_mac)}"
---
#
# Antworten von ${public_ip} gehen über dieses Bein zurück, nicht über das
# LAN-Bein: Tabelle 100, gewählt von der Regel unten nach Quelladresse.
#
apiVersion: v1alpha1
kind: LinkConfig
name: public
addresses:
  - address: ${public_ip}/${lan_prefix}
    # In der Haupttabelle bleibt das LAN-Bein vorn. Ohne Rang stünde die
    # Netzroute dieses Beins gleichwertig daneben, und Verkehr von ${lan_ip}
    # könnte hier hinausgehen.
    routePriority: 2048
routes:
  - destination: ${lan_cidr}
    source: ${public_ip}
    table: "100"
  - gateway: ${lan_gateway}
    source: ${public_ip}
    table: "100"
---
# Vor `main` (32766), nach Ciliums Regeln (9, 100).
apiVersion: v1alpha1
kind: RoutingRuleConfig
name: "1000"
src: ${public_ip}/32
table: "100"
%{ endif ~}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
%{ for ns in dns_servers ~}
  - address: ${ns}
%{ endfor ~}
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
%{ for ntp in ntp_servers ~}
    - ${ntp}
%{ endfor ~}
---
#
# Ersetzt das von Talos erzeugte Dokument (entfernt in defaults.yaml). Die
# beiden Labels der Control Plane sind dieselben, die Talos setzt.
#
apiVersion: v1alpha1
kind: KubeNodeConfig
#
# Mit dem NFS-Tunnel hat der Node zwei Adressen, und ohne Vorgabe nimmt das
# Kubelet die Tunnel-Adresse als InternalIP - sie sortiert vor dem LAN. Dann
# zeigen `kubernetes.default`, Metriken und Cilium-Health auf den Tunnel.
#
# Die eine Adresse statt des Netzes: public_ip liegt im selben Netz.
#
nodeIP:
  validSubnets:
    - ${lan_ip}/32
%{ if role == "controlplane" ~}
labels:
  node-role.kubernetes.io/control-plane: ""
  node.kubernetes.io/exclude-from-external-load-balancers: ""
#
# Ohne `taints`, auch neben Workern. Talos setzt sonst den NoSchedule-Taint
# auf die Control Plane - hier aber ist sie der Node für alles: Die PVs auf
# local-path liegen auf ihrer Daten-Disk, und die Worker sind Spezialisten
# (GPU) mit eigenem Taint, kein Ausweichplatz.
#
%{ else ~}
#
# Worker: Labels und Taints aus var.nodes.
#
# Kein `node-role.kubernetes.io/worker`, so verlockend es für die Spalte
# ROLES wäre: Auf einem Worker setzt Talos Labels mit den Rechten des
# Kubelets, und die NodeRestriction-Admission verbietet einem Kubelet genau
# dieses Präfix. Talos wendet die Labels als Ganzes an - mit dem einen
# verbotenen fehlen dann alle, auch die aus var.nodes. Im Controller-Log:
#   is not allowed to modify labels: node-role.kubernetes.io/worker
# (Die Control Plane darf es, dort arbeitet Talos mit Admin-Rechten.)
#
%{ if length(labels) > 0 ~}
labels:
%{ for key, value in labels ~}
  ${jsonencode(key)}: ${jsonencode(value)}
%{ endfor ~}
%{ endif ~}
%{ if length(taints) > 0 ~}
taints:
%{ for key, value in taints ~}
  ${jsonencode(key)}: ${jsonencode(value)}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
