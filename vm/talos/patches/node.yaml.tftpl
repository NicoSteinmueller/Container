#
# Netzwerk und Identität des Nodes. Ein Bein, statisch adressiert: ${lan_ip}
# ist zugleich Kubernetes-API-Endpoint und steht in kubeconfig wie talosconfig
# - eine geliehene Adresse wäre dort falsch, sobald ein Lease ausbleibt.
#
# Zugeordnet über die MAC statt über den Interface-Namen, der an der
# PCI-Reihenfolge hängt. Dieselbe MAC steht in der libvirt-Domain.
#
machine:
  network:
    hostname: ${node_name}

    nameservers:
%{ for ns in dns_servers ~}
      - ${ns}
%{ endfor ~}

    interfaces:
      - deviceSelector:
          hardwareAddr: "${node_mac}"
        addresses:
          - ${lan_ip}/${lan_prefix}
        routes:
          - network: 0.0.0.0/0
            gateway: ${lan_gateway}

  time:
    disabled: false
    servers:
%{ for ntp in ntp_servers ~}
      - ${ntp}
%{ endfor ~}

  features:
    #
    # Lokaler Endpoint der Kubernetes-API für hostNetwork-Komponenten: Der Weg
    # verlässt den Node nicht und überlebt einen Adresswechsel.
    #
    kubePrism:
      enabled: true
      port: 7445

    # apid prüft die ExtKeyUsage der Client-Zertifikate; sonst wäre jedes von
    # der Talos-CA signierte Zertifikat auch ein Admin-Zertifikat.
    apidCheckExtKeyUsage: true

    # Kein Weg von einem Pod zur Talos-API. Der Cluster darf die Maschine nicht
    # konfigurieren, auf der er läuft.
    kubernetesTalosAPIAccess:
      enabled: false
