#
# Vorlage. Die echten Werte liegen in
# $HOMELAB_VALUES/vm/talos/terraform.tfvars.
#

# --- libvirt -----------------------------------------------------------

# Ohne diese Zeile läuft alles gegen die eigene Arbeitsstation.
# Lokaler Testlauf: "qemu:///system".
libvirt_uri = "qemu+ssh://root@<host>/system"

# Kommt `virsh --connect "$libvirt_uri" pool-list --all` leer zurück, legt
# dieses Modul den Pool an. Bringt ihn ein anderes Modul mit, bleibt
# manage_pool aus - ein libvirt-Objekt in zwei States ist beim Zerstören eine
# Fehlerquelle.
libvirt_pool = "homelab"
manage_pool  = true
pool_path    = "/mnt/cache/domains"

# UEFI-Firmware, auf Host zwingend: Der mitgelieferte libvirt-Deskriptor
# nennt /usr/share/qemu/edk2-i386-vars.fd als NVRAM-Vorlage, und genau diese
# Datei fehlt im Paket. Lokal beide Zeilen weglassen.
efi_loader        = "/usr/share/qemu/ovmf-x64/OVMF_CODE-pure-efi.fd"
efi_vars_template = "/usr/share/qemu/ovmf-x64/OVMF_VARS-pure-efi.fd"

# --- Netz --------------------------------------------------------------

# Genau einen Weg wählen. Zeigt `ip -br link` kein br0, ist Bridging aus - dann
# macvtap, mit der Folge, dass Hypervisor und VM einander nicht sehen.
lan_macvtap_dev = "<bond0|eth0>"
# lan_bridge          = "br0"        # Host mit Bridging
# lan_libvirt_network = "default"    # lokaler Testlauf

# lan_ip außerhalb des DHCP-Bereichs; zugleich API-Endpoint und talosctl-Ziel.
lan_cidr    = "192.168.1.0/24"
lan_ip      = "192.168.1.230"
lan_gateway = "192.168.1.1"

# Zuerst der Router, nicht ein Resolver im Cluster: ein Baustein weniger, der
# beim ersten Aufbau kaputt sein kann.
dns_servers = ["192.168.178.1"]
ntp_servers = ["192.168.178.1"]

# Wer die Talos-API und den kube-apiserver erreichen darf; alles andere blockt
# die Ingress-Firewall. Einzeladressen statt des ganzen LAN, wo es geht - aber
# mindestens einen zweiten Weg vorsehen, sonst ist der Rueckweg bei einer
# gewechselten DHCP-Adresse die serielle Konsole. Vorher pruefen:
#   ip -4 -br addr show scope global
admin_sources = ["192.168.1.2/32", "192.168.1.3/32"]

# --- Dimensionierung ---------------------------------------------------

# 4 GB tragen den leeren Cluster. Vor jeder Erhöhung `free -m` auf dem Host:
# maßgeblich ist `available`, nicht `free`
vm_memory_mib = 4096
vm_vcpu       = 4
vm_disk_gib   = 100

# --- MAC ---------------------------------------------------------------

# Im QEMU-Bereich 52:54:00 und kollisionsfrei.
node_mac = "52:54:00:00:00:01"
