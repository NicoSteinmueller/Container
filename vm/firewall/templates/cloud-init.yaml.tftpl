#cloud-config
#
# Erstkonfiguration der Firewall-VM - von Terraform gerendert aus
# vm/firewall/templates/cloud-init.yaml.tftpl.
#
# Das Konzept (k8s/Edge-Architektur.md, Abschnitt 5) sah Ansible für die
# Regeln vor. Da die VM ohnehin nur eine Aufgabe hat und Ansible einen zweiten
# Weg auf die Maschine bräuchte, kommt hier alles aus Terraform: ein
# `terraform apply`, danach nichts mehr von Hand. Ansible bleibt für die
# Unraid-Hosts und Minikube relevant.
#

hostname: ${vm_name}
fqdn: ${vm_name}
prefer_fqdn_over_hostname: false
manage_etc_hosts: true

#
# Cloud-Init lädt growpart früh im init-Stage, findet das Werkzeug im
# Basis-Image aber nicht (alpine-cloud-images liefert nur e2fsprogs-extra).
# Ohne das hier bleibt das Root-Dateisystem bei den ~200 MB des Images.
#
bootcmd:
  - apk add --no-cache --quiet cloud-utils-growpart || true

growpart:
  mode: auto
  devices: ["/"]

resize_rootfs: true

package_update: true
package_upgrade: true

#
# openssh fehlt hier bewusst: Das Cloud-Image bringt openssh-server-pam mit,
# und das Meta-Paket "openssh" würde openssh-server nachziehen - ein Konflikt,
# an dem das Paket-Modul abbricht.
#
packages:
  - nftables
  - sudo
  - chrony
  - qemu-guest-agent
  - iproute2
  - util-linux
  - cloud-utils-growpart
  - tcpdump
  - conntrack-tools
%{ for pkg in extra_packages ~}
  - ${pkg}
%{ endfor ~}

users:
  - name: ${admin_user}
    gecos: Firewall-Administration
    groups: wheel
    shell: /bin/ash
    lock_passwd: true
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
%{ for key in ssh_authorized_keys ~}
      - "${key}"
%{ endfor ~}

disable_root: true
ssh_pwauth: false

write_files:
  #
  # Regelsatz. Quelle der Wahrheit ist das Repo - verify/assert-ruleset.sh
  # vergleicht diese Datei und den geladenen Zustand dagegen.
  #
  - path: /etc/nftables.nft
    owner: root:root
    permissions: "0640"
    content: |
      ${indent(6, nftables_ruleset)}

  - path: /etc/nftables.panic.nft
    owner: root:root
    permissions: "0640"
    content: |
      ${indent(6, nftables_panic)}

  #
  # MAC -> nft-Define. Wird beim Start in Interface-Namen aufgelöst.
  #
  - path: /etc/firewall/interfaces.map
    owner: root:root
    permissions: "0644"
    content: |
      ${indent(6, interfaces_map)}

  - path: /usr/local/sbin/fw-render-interfaces
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, fw_render_interfaces)}

  - path: /etc/init.d/firewall
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, firewall_initd)}

  - path: /etc/ssh/sshd_config
    owner: root:root
    permissions: "0600"
    content: |
      ${indent(6, sshd_config)}

  #
  # Härtung auf Kernel-Ebene. ip_forward steht hier bewusst auf 0 - freigegeben
  # wird es erst von /etc/init.d/firewall, nachdem der Regelsatz geladen ist.
  #
  - path: /etc/sysctl.d/99-firewall.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.ipv4.ip_forward = 0

      # IPv6 komplett aus: globale v6-Adressen in DMZ oder Cluster wären an
      # NAT und Firewall vorbei direkt erreichbar - der häufigste Fehler bei
      # genau dieser Konstruktion (k8s/Edge-Architektur.md, Abschnitt 5).
      net.ipv6.conf.all.disable_ipv6 = 1
      net.ipv6.conf.default.disable_ipv6 = 1
      net.ipv6.conf.lo.disable_ipv6 = 1

      # Anti-Spoofing und Router-Hygiene
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.secure_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv4.conf.default.accept_source_route = 0
      net.ipv4.conf.all.log_martians = 1
      net.ipv4.conf.all.arp_ignore = 1
      net.ipv4.conf.all.arp_announce = 2
      net.ipv4.icmp_echo_ignore_broadcasts = 1
      net.ipv4.icmp_ignore_bogus_error_responses = 1
      net.ipv4.tcp_syncookies = 1

      # Kernel-Interna nicht an unprivilegierte Prozesse ausliefern
      kernel.kptr_restrict = 2
      kernel.dmesg_restrict = 1

  #
  # Deny-Logs der nftables-Regeln landen über klogd in /var/log/messages.
  # Mit syslog_remote gehen sie zusätzlich an den Loki-Stack.
  #
  - path: /etc/conf.d/syslog
    owner: root:root
    permissions: "0644"
    content: |
      SYSLOGD_OPTS="-t -s 2048 -b 5${syslog_remote_opts}"

%{ if auto_upgrade ~}
  #
  # Wöchentliches apk upgrade (k8s/CI-CD-Konzept.md, Abschnitt 5).
  # Kernel-Updates werden erst nach einem Reboot wirksam - der bleibt bewusst
  # manuell, weil währenddessen nichts nach außen erreichbar ist.
  #
  - path: /etc/periodic/weekly/apk-upgrade
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      apk update >/dev/null
      out=$(apk upgrade --no-cache 2>&1) || {
        logger -t apk-upgrade -p daemon.err "fehlgeschlagen: $out"
        exit 1
      }
      logger -t apk-upgrade -p daemon.info "ok: $(echo "$out" | tr '\n' ' ')"
%{ endif ~}

runcmd:
  - [ setup-timezone, -z, "${timezone}" ]

  # Härtung sofort aktiv, nicht erst nach dem nächsten Reboot
  - [ sysctl, -p, /etc/sysctl.d/99-firewall.conf ]

  # Firewall im boot-Runlevel: vor networking, damit es kein Zeitfenster mit
  # konfiguriertem Netz und ohne Regelsatz gibt.
  - [ rc-update, add, firewall, boot ]
  - [ rc-update, add, sysctl, boot ]
  - [ rc-update, add, syslog, boot ]
  - [ rc-update, add, klogd, boot ]
  - [ rc-update, add, sshd, default ]
  - [ rc-update, add, chronyd, default ]
  - [ rc-update, add, qemu-guest-agent, default ]
%{ if auto_upgrade ~}
  - [ rc-update, add, crond, default ]
%{ endif ~}

  - [ rc-service, syslog, restart ]
  - [ rc-service, klogd, restart ]
  - [ rc-service, firewall, start ]
  - [ rc-service, sshd, restart ]
  - [ rc-service, chronyd, restart ]
  - [ rc-service, qemu-guest-agent, start ]
%{ if auto_upgrade ~}
  - [ rc-service, crond, start ]
%{ endif ~}

  # Abschließender Beleg im Cloud-Init-Log: /var/log/cloud-init-output.log
  - [ sh, -c, "nft -s list ruleset > /var/log/firewall-ruleset.log 2>&1 || true" ]
  - [ sh, -c, "ip -br address > /var/log/firewall-interfaces.log 2>&1 || true" ]

final_message: "Firewall-VM ${vm_name} ist nach $UPTIME Sekunden fertig konfiguriert."
