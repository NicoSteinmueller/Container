#!/usr/sbin/nft -f
#
# Notfall-Regelsatz - von Terraform gerendert aus
# vm/firewall/templates/nftables-panic.nft.tftpl.
#
# Wird von /etc/init.d/firewall geladen, wenn der eigentliche Regelsatz nicht
# fehlerfrei lädt. Ohne diesen Fallback wäre der Fehlerfall ein Router ganz ohne
# Regeln - also offen. Hier ist er dicht, mit genau einer Ausnahme: SSH über das
# Management-Netz, damit die VM reparierbar bleibt.
#
# Bewusst ohne include: Der Fallback darf nicht davon abhängen, dass die
# Interface-Auflösung funktioniert hat. Deshalb wird ausschließlich über
# Adressen gematcht.
#

flush ruleset

table inet panic {
  chain input {
    type filter hook input priority filter; policy drop;

    iif lo accept
    ct state established,related accept
    ip saddr ${mgmt_cidr} ip daddr ${mgmt_ip} tcp dport 22 counter accept comment "SSH nur Management"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    counter comment "kein Durchgangsverkehr im Panic-Modus"
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
