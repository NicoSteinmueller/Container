#!/sbin/openrc-run
#
# Lädt den nftables-Regelsatz und gibt erst danach das IPv4-Forwarding frei.
#
# Warum ein eigener Service statt /etc/init.d/nftables:
#
#   1. Fail-closed. Scheitert das Laden, ist die Alternative ein Router ohne
#      Regeln - also offen. Hier wird stattdessen der Panic-Regelsatz geladen
#      und das Forwarding bleibt aus.
#   2. Reihenfolge. Interface-Namen werden vorher aus den MACs aufgelöst
#      (fw-render-interfaces), sonst passt der Regelsatz nicht zu den Segmenten.
#   3. ip_forward hängt am Erfolg des Ladens, nicht an sysctl.conf beim Boot.
#
# Der Service läuft im boot-Runlevel und damit vor networking: die Links
# existieren zu dem Zeitpunkt bereits (Kernel), konfiguriert sind sie noch
# nicht. Genau so soll es sein - nie ein Zeitfenster mit aktivem Netz und
# ohne Regeln.
#

description="nftables-Regelsatz der Firewall-VM"

RULESET=${RULESET:-/etc/nftables.nft}
PANIC=${PANIC:-/etc/nftables.panic.nft}
RENDER=${RENDER:-/usr/local/sbin/fw-render-interfaces}

extra_commands="check show"
description_check="Regelsatz nur prüfen, nicht laden"
description_show="Aktiven Regelsatz ausgeben"

depend() {
	need localmount
	before net sshd
}

load_panic() {
	sysctl -qw net.ipv4.ip_forward=0 >/dev/null 2>&1
	nft -f "$PANIC"
}

start() {
	ebegin "Lade Firewall-Regelsatz"

	if ! "$RENDER"; then
		eerror "Interface-Auflösung fehlgeschlagen - lade Panic-Regelsatz"
		load_panic
		eend 1 "Firewall im Panic-Modus"
		return 1
	fi

	if ! nft -f "$RULESET"; then
		eerror "Regelsatz konnte nicht geladen werden - lade Panic-Regelsatz"
		load_panic
		eend 1 "Firewall im Panic-Modus"
		return 1
	fi

	sysctl -qw net.ipv4.ip_forward=1 >/dev/null
	eend 0
}

stop() {
	ebegin "Firewall stilllegen (Panic-Regelsatz)"
	load_panic
	eend $?
}

check() {
	"$RENDER" && nft -c -f "$RULESET"
}

show() {
	nft -s list ruleset
}
