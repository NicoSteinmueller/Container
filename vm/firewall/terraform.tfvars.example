#
# Kopieren nach terraform.tfvars und anpassen.
#
# Ohne ssh_authorized_keys läuft kein Apply - das ist der einzige Wert, der
# zwingend gesetzt werden muss. Alle übrigen Vorgaben entsprechen
# k8s/Edge-Architektur.md, Abschnitt 4.
#

ssh_authorized_keys = [
  "ssh-ed25519 AAAA... nico@workstation",
]

#
# Auf Unraid: Name der vorhandenen Bridge über bond0 - vorher mit
# `ip -br link` auf dem Host gegenprüfen.
#
# Für einen lokalen Testlauf stattdessen:
#   wan_bridge          = null
#   wan_libvirt_network = "default"
#   wan_ip              = "192.168.122.6"
#   wan_gateway         = "192.168.122.1"
#   lan_cidr            = "192.168.122.0/24"
#
wan_bridge = "br0"

# libvirt auf Unraid statt lokal:
# libvirt_uri  = "qemu+ssh://root@192.168.178.2/system"
# libvirt_pool = "default"

# Heimnetz
wan_ip      = "192.168.178.6"
wan_gateway = "192.168.178.1"
lan_cidr    = "192.168.178.0/24"
dns_servers = ["192.168.178.1"]

# Segmente
dmz_cidr           = "10.10.20.0/24"
edge_ip            = "10.10.20.10"
cluster_cidr       = "10.10.30.0/24"
cluster_ingress_ip = "10.10.30.100"

# Deny-Logs zusätzlich an den Loki-Stack (Syslog-Empfänger dort vorausgesetzt):
# syslog_remote = "192.168.178.4:1514"

# Zugriff auf kube-apiserver und talosctl aus dem LAN. Leer lassen, solange der
# Weg über WireGuard läuft - so sieht es Kapitel 4 des Konzepts vor.
# admin_sources = ["192.168.178.30/32"]
