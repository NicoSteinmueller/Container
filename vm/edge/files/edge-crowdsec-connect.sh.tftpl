#!/usr/bin/env bash
#
# Verbindet Agent und Bouncer der Edge-VM mit der CrowdSec-LAPI im Cluster -
# von Terraform gerendert nach /usr/local/sbin/edge-crowdsec-connect.
#
# Die Zugangsdaten entstehen im Cluster und werden hier eingetragen. Bewusst
# nicht über Terraform: Sonst lägen LAPI-Zugangsdaten im Terraform-State und
# in der Seed-ISO im Storage-Pool.
#
#   # im Cluster:
#   cscli machines add ${machine_id} --password '<agent-passwort>'
#   cscli bouncers add ${machine_id}-firewall
#   cscli bouncers add ${machine_id}-traefik
#
#   # auf der Edge-VM:
#   sudo edge-crowdsec-connect \
#     --agent-password '<agent-passwort>' \
#     --firewall-key '<firewall-bouncer-key>' \
#     --traefik-key '<traefik-bouncer-key>'
#
# Der Firewall-Bouncer bleibt dabei aus. Das Konzept sieht ein bis zwei Wochen
# Beobachtungsmodus vor: erst `cscli alerts list` auswerten, die Fehlalarme der
# Immich-Clients kennenlernen, dann scharfschalten mit
#
#   sudo edge-crowdsec-connect --arm-firewall-bouncer
#
set -euo pipefail

MACHINE_ID="${machine_id}"
LAPI_URL="${lapi_url}"
PKI_DIR="${pki_dir}"
SECRETS_DIR="${secrets_dir}"
CREDS=/etc/crowdsec/local_api_credentials.yaml
BOUNCER_CFG=/etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml

agent_password=""
firewall_key=""
traefik_key=""
arm_firewall=false

while [ $# -gt 0 ]; do
  case "$1" in
    --agent-password) agent_password="$2"; shift 2 ;;
    --firewall-key) firewall_key="$2"; shift 2 ;;
    --traefik-key) traefik_key="$2"; shift 2 ;;
    --arm-firewall-bouncer) arm_firewall=true; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) echo "unbekannte Option: $1" >&2; exit 64 ;;
  esac
done

log() { printf '[edge-crowdsec-connect] %s\n' "$*"; }

if [ ! -f "$${PKI_DIR}/edge-client.crt" ]; then
  echo "Kein Client-Zertifikat - erst edge-mtls-bootstrap ausführen." >&2
  echo "Der Weg zur LAPI läuft ausschließlich über die mTLS-Strecke." >&2
  exit 78
fi

# ---------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------
if [ -n "$agent_password" ]; then
  log "schreibe $CREDS"

  #
  # Zwei Faktoren gleichzeitig: Machine-Credentials und Client-Zertifikat.
  # Das Zertifikat ist dabei der Türsteher, den die NetworkPolicy im Cluster
  # ebenfalls prüft - Zugang aus der DMZ gibt es nur über diese Strecke.
  #
  umask 077
  cat > "$CREDS" <<EOF
url: $${LAPI_URL}
login: $${MACHINE_ID}
password: '$${agent_password}'
ca_cert_path: $${PKI_DIR}/internal-ca.crt
cert_path: $${PKI_DIR}/edge-client.crt
key_path: $${PKI_DIR}/edge-client.key
EOF
  chmod 0600 "$CREDS"

  log "aktiviere den Agenten"
  systemctl enable --now crowdsec.service
  sleep 3
  cscli lapi status || {
    echo "LAPI nicht erreichbar - Regelsatz, Zertifikat und Zugangsdaten prüfen." >&2
    exit 1
  }
fi

# ---------------------------------------------------------------------
# Traefik-Plugin-Bouncer
# ---------------------------------------------------------------------
if [ -n "$traefik_key" ]; then
  log "hinterlege den Bouncer-Key für Traefik"
  install -d -o root -g traefik -m 0750 "$${SECRETS_DIR}"
  printf '%s' "$traefik_key" > "$${SECRETS_DIR}/lapi-bouncer.key"
  chown root:traefik "$${SECRETS_DIR}/lapi-bouncer.key"
  chmod 0640 "$${SECRETS_DIR}/lapi-bouncer.key"
  systemctl reload-or-restart traefik.service
fi

# ---------------------------------------------------------------------
# Firewall-Bouncer
# ---------------------------------------------------------------------
if [ -n "$firewall_key" ]; then
  log "trage den API-Key in $BOUNCER_CFG ein"
  sed -i "s|^api_key:.*|api_key: $${firewall_key}|" "$BOUNCER_CFG"
  chmod 0600 "$BOUNCER_CFG"
fi

if [ "$arm_firewall" = true ]; then
  if grep -q '^api_key: *$' "$BOUNCER_CFG" || grep -q 'BITTE-EINTRAGEN' "$BOUNCER_CFG"; then
    echo "Im Bouncer steht kein API-Key - erst --firewall-key setzen." >&2
    exit 78
  fi

  #
  # Ab hier sperrt die Maschine selbstständig auf Paketebene. Der Notzugang
  # führt nicht über das Netz: virsh console auf dem Hypervisor. Eine Whitelist
  # auf LAN-Adressen leistet das nicht - der Firewall-Bouncer sieht keine
  # HTTP-Kopfzeilen, sondern nur Adressen aus den Entscheidungen der LAPI.
  #
  log "schalte den Firewall-Bouncer scharf"
  systemctl enable --now crowdsec-firewall-bouncer.service
  systemctl is-active --quiet crowdsec-firewall-bouncer.service \
    && log "Firewall-Bouncer läuft - Sperren greifen jetzt in nftables" \
    || { echo "Firewall-Bouncer startet nicht - journalctl -u crowdsec-firewall-bouncer" >&2; exit 1; }
else
  log "Firewall-Bouncer bleibt aus (Beobachtungsmodus)"
fi

log "Status:"
cscli metrics 2>/dev/null | head -20 || true
