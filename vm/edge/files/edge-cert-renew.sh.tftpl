#!/usr/bin/env bash
#
# Erneuert das mTLS-Client-Zertifikat der Edge-VM - von Terraform gerendert
# nach /usr/local/sbin/edge-cert-renew, ausgeführt von edge-cert-renew.timer.
#
# Läuft häufiger, als es erneuert: `step ca renew --expires-in` schreibt nur,
# wenn weniger als ${renew_before} Restlaufzeit übrig sind. Bei ${cert_lifetime}
# Gesamtlaufzeit bleibt damit ein großes Fenster für einen fehlgeschlagenen
# Versuch, ohne dass die Strecke ausfällt.
#
set -euo pipefail

PKI_DIR="${pki_dir}"
CRT="$${PKI_DIR}/edge-client.crt"
KEY="$${PKI_DIR}/edge-client.key"
export STEPPATH="${step_path}"

log() { logger -t edge-cert-renew -p daemon.info -- "$*"; printf '%s\n' "$*"; }
err() { logger -t edge-cert-renew -p daemon.err -- "$*"; printf '%s\n' "$*" >&2; }

if [ ! -f "$CRT" ]; then
  err "kein Zertifikat unter $CRT - zuerst edge-mtls-bootstrap ausführen"
  exit 78
fi

before="$(sha256sum "$CRT" | cut -d' ' -f1)"

#
# Authentifiziert sich mit dem aktuellen Zertifikat (mTLS). Schlägt fehl,
# sobald das Zertifikat abgelaufen ist - dann ist der Bootstrap mit einem
# neuen Token nötig. Das ist Absicht: Ein abgelaufenes Zertifikat soll sich
# nicht selbst wiederbeleben können.
#
if ! step ca renew --force --expires-in "${renew_before}" "$CRT" "$KEY"; then
  err "Erneuerung fehlgeschlagen - Restlaufzeit prüfen: step certificate inspect $CRT --short"
  exit 1
fi

after="$(sha256sum "$CRT" | cut -d' ' -f1)"

if [ "$before" = "$after" ]; then
  exit 0
fi

chown root:traefik "$CRT" "$KEY"
chmod 0640 "$CRT" "$KEY"

# Das Wurzelzertifikat mitziehen, damit eine CA-Rotation nicht unbemerkt die
# Strecke bricht.
step ca root "$${PKI_DIR}/internal-ca.crt" >/dev/null 2>&1 || true
chown root:traefik "$${PKI_DIR}/internal-ca.crt"
chmod 0640 "$${PKI_DIR}/internal-ca.crt"

#
# Traefik liest Zertifikatsdateien nur beim Laden der dynamischen
# Konfiguration. Der File-Watcher reagiert auf die Schreiboperation an dieser
# Datei und baut den serversTransport neu auf - ohne Neustart und ohne
# abgebrochene Verbindungen.
#
touch /etc/traefik/dynamic/servers-transport.yml

log "Zertifikat erneuert: $(step certificate inspect "$CRT" --format json 2>/dev/null | sed -n 's/.*"not_after": *"\([^"]*\)".*/\1/p' | head -1)"
