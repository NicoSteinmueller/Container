#
# Acquisition: AppSec/WAF - von Terraform gerendert nach
# /etc/crowdsec/acquis.d/appsec.yaml. NICHT auf der VM bearbeiten.
#
# Stufe 5 der Verarbeitungskette. Zwei Listener, weil der Regelzuschnitt
# pfadabhängig ist und die Auswahl der Regelsätze am Listener hängt, nicht am
# Request: Traefik schickt Anfragen je nach Router an den einen oder den
# anderen Port (siehe dynamic/middlewares.yml).
#
# Beide lauschen nur auf dem Loopback. Traefik läuft auf derselben Maschine,
# und ein AppSec-Port, der aus dem Netz erreichbar wäre, ließe sich umgehen
# oder direkt befragen.
#

#
# Scharf: Virtual Patching plus OWASP CRS. Für alles, was Weboberfläche ist.
# Virtual Patching ist der praktische Nutzen im Alltag - wird morgen eine
# Nextcloud-Lücke bekannt, gibt es meist innerhalb von Stunden eine Regel,
# deutlich bevor man selbst zum Updaten kommt.
#
appsec_configs:
  - crowdsecurity/appsec-default
  - crowdsecurity/crs
labels:
  type: appsec
source: appsec
name: appsec-strict
listen_addr: ${appsec_strict_addr}

---
#
# Gelockert: nur Virtual Patching, kein CRS. Für WebDAV- und Sync-Pfade.
#
# Grund: Nextcloud nutzt dort Methoden, die generische Regelwerke per Default
# blocken (PROPFIND, MKCOL, COPY, MOVE, REPORT, LOCK), seine Request-Bodies
# sind XML mit Sonderzeichen, die Injection-Regeln auslösen, und binäre
# Uploads laufen durch die Payload-Inspektion. Ein bewusster Kompromiss - die
# Alternative ist eine Sync-Funktion, die sporadisch und unerklärlich abbricht.
#
# Wenn die Weboberfläche von Nextcloud CRS-Fehlalarme auslöst, gehört
# crowdsecurity/appsec-crs-exclusion-plugin-nextcloud in die obere Liste;
# die Collection ist installiert. Siehe https://app.crowdsec.net/hub
#
appsec_configs:
  - crowdsecurity/appsec-default
labels:
  type: appsec
source: appsec
name: appsec-patching
listen_addr: ${appsec_patching_addr}
