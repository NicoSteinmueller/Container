#
# sshd-Ergänzung der Edge-VM - von Terraform gerendert aus
# vm/edge/templates/sshd_config.tftpl nach /etc/ssh/sshd_config.d/99-edge.conf.
#
# Debians sshd_config zieht dieses Verzeichnis mit `Include` ganz oben ein; die
# erste Definition eines Schlüssels gewinnt, damit hat diese Datei Vorrang vor
# den Vorgaben aus /etc/ssh/sshd_config.
#
# Nicht aber vor 50-cloud-init.conf: Das Verzeichnis wird alphabetisch
# eingelesen, 50 kommt vor 99. cloud-init setzt dort nur
# PasswordAuthentication - denselben Wert wie hier. Wer weitere Schlüssel
# ergänzt, muss gegenprüfen, ob cloud-init sie ebenfalls schreibt.
#
# NICHT auf der VM bearbeiten - vm/edge/verify/assert-ruleset.sh vergleicht
# gegen den Stand im Repo.
#

#
# Nur auf dem LAN-Bein lauschen. Auf dem DMZ-Bein hätte SSH nichts zu suchen:
# Dort steht der Cluster, und aus dem Cluster in die DMZ soll gar nichts
# aufgebaut werden. Der nftables-Regelsatz setzt dieselbe Grenze noch einmal
# unabhängig davon.
#
ListenAddress ${lan_ip}

# Nur Public-Key. Die VM hat keinen Benutzer mit Passwort, und das soll auch
# nach einem `passwd` von Hand so bleiben.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PubkeyAuthentication yes

PermitRootLogin no
AllowUsers ${admin_user}

# Ein übernommener sshd soll kein Sprungbrett ins LAN sein - die Weiterleitung
# liefe an nftables vorbei, weil sie erst hinter dem Socket entsteht.
AllowTcpForwarding no
AllowAgentForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no

MaxAuthTries 3
MaxSessions 4
LoginGraceTime 20
ClientAliveInterval 300
ClientAliveCountMax 2

# Fehlversuche mit Quelladresse ins Log - das ist die Datengrundlage für den
# CrowdSec-Agenten auf dieser Maschine.
LogLevel VERBOSE
