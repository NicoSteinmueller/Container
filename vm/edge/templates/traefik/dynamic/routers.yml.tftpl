#
# Router und Services - von Terraform gerendert aus der Variablen
# `public_services`. NICHT auf der VM bearbeiten.
#
# Jeder öffentliche Name bekommt einen Basis-Router und, wo nötig, zusätzliche
# Router für einzelne Pfade. Traefik wählt bei mehreren Treffern den Router mit
# der höheren `priority` - deshalb sind die Pfad-Router hier höher eingestuft
# als der Basis-Router, der nur den Hostnamen prüft.
#
# Alle Router zeigen auf denselben Service: eine IP, ein Port, mTLS.
#
%{ if !crowdsec_armed ~}
# ACHTUNG: crowdsec_bouncer_armed = false - die Router laufen ohne Bouncer und
# ohne WAF. Das Plugin verweigert den Dienst, solange die Key-Datei fehlt, und
# risse sonst jeden Router mit. Nach edge-crowdsec-connect auf true setzen.
#
%{ endif ~}

http:
  routers:
%{ for svc in services ~}

    # ---------------------------------------------------------------
    # ${svc.host}
    # ---------------------------------------------------------------
    ${svc.name}:
      rule: "Host(`${svc.host}`)"
      entryPoints:
        - websecure
      priority: 10
      middlewares:
        - strip-client-forwarded
        - hsts
%{ if crowdsec_armed ~}
        - crowdsec-strict
%{ endif ~}
        - rl-default
      service: cluster
      tls:
        certResolver: acmedns
        options: default
        domains:
          - main: "${svc.host}"
%{ if length(svc.strict_paths) > 0 ~}

    # Login-Pfade: strenges Rate Limiting, WAF unverändert scharf.
    ${svc.name}-strict:
      rule: "Host(`${svc.host}`) && (${join(" || ", [for p in svc.strict_paths : "PathPrefix(`${p}`)"])})"
      entryPoints:
        - websecure
      priority: 30
      middlewares:
        - strip-client-forwarded
        - hsts
%{ if crowdsec_armed ~}
        - crowdsec-strict
%{ endif ~}
        - rl-strict
      service: cluster
      tls:
        certResolver: acmedns
        options: default
        domains:
          - main: "${svc.host}"
%{ endif ~}
%{ if length(svc.relaxed_paths) > 0 ~}

    # Sync-Pfade: großzügiges Rate Limiting, AppSec nur mit Virtual Patching.
    # Der bewusste Kompromiss aus dem Konzept - siehe middlewares.yml.
    ${svc.name}-relaxed:
      rule: "Host(`${svc.host}`) && (${join(" || ", [for p in svc.relaxed_paths : "PathPrefix(`${p}`)"])})"
      entryPoints:
        - websecure
      priority: 20
      middlewares:
        - strip-client-forwarded
        - hsts
%{ if crowdsec_armed ~}
        - crowdsec-patching
%{ endif ~}
        - rl-relaxed
      service: cluster
      tls:
        certResolver: acmedns
        options: default
        domains:
          - main: "${svc.host}"
%{ endif ~}
%{ endfor ~}

    #
    # Alles ohne konfigurierten Hostnamen. Praktisch unerreichbar, weil
    # sniStrict den Handshake schon vorher abbricht (tls.yml) - der Router ist
    # die zweite Absicherung für den Fall, dass eine bestehende HTTP/2- oder
    # HTTP/3-Verbindung mit fremdem Host-Header weiterbenutzt wird.
    #
    catch-all:
      rule: "HostRegexp(`^.+$`)"
      entryPoints:
        - websecure
      priority: 1
      middlewares:
        - deny-all
      service: blackhole

  services:
    #
    # Der einzige Weg nach innen: ingress-public im Talos-Node, über die
    # isolierte DMZ-Strecke, mit Client-Zertifikat (servers-transport.yml).
    #
    # passHostHeader bleibt an, damit der Ingress und die Anwendung dahinter
    # den öffentlichen Namen sehen - sonst baut Nextcloud interne Links mit der
    # IP der Edge-VM.
    #
    cluster:
      loadBalancer:
        passHostHeader: true
        serversTransport: cluster-mtls
        servers:
          - url: "https://${ingress_ip}:${ingress_port}"

    blackhole:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:1"
