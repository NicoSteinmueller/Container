#
# Middlewares - von Terraform gerendert, NICHT auf der VM bearbeiten.
#
# Hier stehen die Stufen 2, 5 und 6 der Verarbeitungskette: CrowdSec-Abfrage,
# AppSec/WAF, Rate Limiting und die Kopfzeilen-Hygiene.
#

http:
  middlewares:

    #
    # Kopfzeilen, die der Client mitschickt und die weiter unten als
    # "echte IP" missverstanden werden könnten.
    #
    # X-Forwarded-* und X-Real-Ip wirft Traefik schon am EntryPoint weg, weil
    # dort kein trustedIPs-Eintrag steht. Nicht dabei sind die hier gelisteten
    # Namen: `Forwarded` (RFC 7239) und die CDN-Varianten. Ein leerer Wert
    # entfernt die Kopfzeile.
    #
    # Warum das zählt: Wenn irgendwo weiter innen jemand CF-Connecting-IP oder
    # X-Original-Forwarded-For auswertet - in einer App, einem Log-Parser, einer
    # Whitelist -, bestimmt sonst der Angreifer, als welche IP er dort gilt.
    #
    strip-client-forwarded:
      headers:
        customRequestHeaders:
          Forwarded: ""
          X-Real-Ip: ""
          X-Client-Ip: ""
          X-Original-Forwarded-For: ""
          CF-Connecting-IP: ""
          True-Client-IP: ""
          Fastly-Client-IP: ""

    #
    # HSTS wird hier gesetzt, die übrigen Sicherheits-Header liefern die
    # Anwendungen selbst. Doppelte Header brechen Teile der Nextcloud-Oberfläche
    # (siehe Konzept, Abschnitt "Nextcloud freischalten").
    #
    hsts:
      headers:
        forceSTSHeader: true
        stsSeconds: 31536000
        stsIncludeSubdomains: true
        stsPreload: ${hsts_preload}

    #
    # Rate Limiting. sourceCriterion bleibt beim Default (TCP-Peer-Adresse) -
    # bewusst nicht über X-Forwarded-For, obwohl der hier korrekt gesetzt ist:
    # Der Peer ist an dieser Stelle der Client, und was nicht aus einer
    # Kopfzeile kommt, kann auch nicht gefälscht werden.
    #
    rl-default:
      rateLimit:
        average: ${rate_default.average}
        burst: ${rate_default.burst}
        period: ${rate_default.period}

    # Streng: Login-Pfade. Trifft Bruteforce, nicht den normalen Betrieb -
    # niemand meldet sich zwanzigmal pro Minute an.
    rl-strict:
      rateLimit:
        average: ${rate_strict.average}
        burst: ${rate_strict.burst}
        period: ${rate_strict.period}

    # Großzügig: Sync-Pfade. Immich-Clients erzeugen im Hintergrund viele
    # Requests, und ein abbrechender Sync ist der teurere Fehler.
    rl-relaxed:
      rateLimit:
        average: ${rate_relaxed.average}
        burst: ${rate_relaxed.burst}
        period: ${rate_relaxed.period}

    #
    # Catch-all: alles, was keinen konfigurierten Hostnamen trifft. Greift nur
    # für Anfragen, die den sniStrict-Filter aus tls.yml schon passiert haben -
    # also praktisch nur bei HTTP/2-Verbindungswiederverwendung mit fremdem
    # Host-Header.
    #
    deny-all:
      ipAllowList:
        sourceRange:
          - "192.0.2.1/32"
%{ if crowdsec_enabled ~}

    #
    # Stufe 2 + 5, scharfe Variante: CrowdSec-Entscheidungen plus vollständiger
    # AppSec-Regelsatz (Virtual Patching und OWASP CRS). Für alles, was
    # Weboberfläche ist.
    #
    # crowdsecMode: ${crowdsec_mode}
    #   stream - der Plugin-Cache hält die gesperrten IPs und aktualisiert sie
    #   alle ${crowdsec_update_interval}s. Bewusst nicht "live": Jede Anfrage einzeln über
    #   die DMZ-Strecke an die LAPI im Cluster zu schicken, macht die
    #   Erreichbarkeit der öffentlichen Dienste von der Erreichbarkeit des
    #   Clusters abhängig.
    #
    # Die Verbindung zur LAPI läuft über dieselbe mTLS-Strecke wie der
    # Nutzverkehr - Client-Zertifikat und interne CA aus /etc/traefik/pki.
    # crowdsecLapiTlsInsecureVerify bleibt aus; ohne Prüfung wäre die
    # Entscheidungsdatenbank über einen beliebigen Gegenüber ansprechbar.
    #
    # clientTrustedIPs ist die Whitelist der eigenen Verwaltungsadressen. Sie
    # steht hier in der Datei und kann von eingehenden Alarmen nicht
    # überschrieben werden - anders als eine Whitelist, die aus Entscheidungen
    # abgeleitet wird. Achtung: Sie schützt nur vor dem Plugin-Bouncer, nicht
    # vor dem Firewall-Bouncer auf nftables-Ebene (siehe README).
    #
    crowdsec-strict:
      plugin:
        crowdsec-bouncer:
          enabled: true
          logLevel: ${crowdsec_log_level}
          crowdsecMode: ${crowdsec_mode}
          updateIntervalSeconds: ${crowdsec_update_interval}
          crowdsecLapiScheme: https
          crowdsecLapiHost: "${lapi_host}"
          crowdsecLapiKeyFile: ${secrets_dir}/lapi-bouncer.key
          crowdsecLapiTlsInsecureVerify: false
          crowdsecLapiTlsCertificateAuthorityFile: ${pki_dir}/internal-ca.crt
          crowdsecLapiTlsCertificateBouncerFile: ${pki_dir}/edge-client.crt
          crowdsecLapiTlsCertificateBouncerKeyFile: ${pki_dir}/edge-client.key
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: "${appsec_strict_host}"
          crowdsecAppsecScheme: http
          crowdsecAppsecFailureBlock: true
          crowdsecAppsecUnreachableBlock: true
          crowdsecAppsecBodyLimit: ${appsec_body_limit}
          clientTrustedIPs:
%{ for src in admin_sources ~}
            - "${src}"
%{ endfor ~}
          # Leer: Der Client ist hier der TCP-Peer. Stünde hier etwas, würde das
          # Plugin wieder einer Kopfzeile glauben.
          forwardedHeadersTrustedIPs: []

    #
    # Stufe 2 + 5, gelockerte Variante: dieselbe CrowdSec-Abfrage, aber ein
    # AppSec-Listener, auf dem nur Virtual Patching läuft (Port
    # ${appsec_patching_host}, eigene Acquisition in /etc/crowdsec/acquis.d).
    #
    # Für WebDAV-Pfade. Nextcloud nutzt dort Methoden, die generische
    # Regelwerke blocken - PROPFIND, MKCOL, COPY, MOVE, REPORT, LOCK -, seine
    # Bodies sind XML mit Sonderzeichen, die Injection-Regeln auslösen, und
    # binäre Uploads laufen durch die Payload-Inspektion.
    #
    # Bewusster Kompromiss, im Konzept als Restrisiko notiert: Auf demselben
    # Pfad liegen damit gelockerte WAF und großzügiges Rate Limiting
    # übereinander, und er akzeptiert Basic-Auth mit denselben Passwörtern wie
    # das Webformular. Die saubere Auflösung wäre eine Staffelung nach
    # Antwortcode plus erzwungene App-Passwörter - beides gehört in den Cluster
    # und nicht hierher.
    #
    crowdsec-patching:
      plugin:
        crowdsec-bouncer:
          enabled: true
          logLevel: ${crowdsec_log_level}
          crowdsecMode: ${crowdsec_mode}
          updateIntervalSeconds: ${crowdsec_update_interval}
          crowdsecLapiScheme: https
          crowdsecLapiHost: "${lapi_host}"
          crowdsecLapiKeyFile: ${secrets_dir}/lapi-bouncer.key
          crowdsecLapiTlsInsecureVerify: false
          crowdsecLapiTlsCertificateAuthorityFile: ${pki_dir}/internal-ca.crt
          crowdsecLapiTlsCertificateBouncerFile: ${pki_dir}/edge-client.crt
          crowdsecLapiTlsCertificateBouncerKeyFile: ${pki_dir}/edge-client.key
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: "${appsec_patching_host}"
          crowdsecAppsecScheme: http
          crowdsecAppsecFailureBlock: true
          crowdsecAppsecUnreachableBlock: true
          crowdsecAppsecBodyLimit: ${appsec_body_limit}
          clientTrustedIPs:
%{ for src in admin_sources ~}
            - "${src}"
%{ endfor ~}
          forwardedHeadersTrustedIPs: []
%{ endif ~}
