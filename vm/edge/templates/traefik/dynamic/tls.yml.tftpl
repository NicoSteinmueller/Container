#
# TLS-Optionen - von Terraform gerendert, NICHT auf der VM bearbeiten.
#
# Stufe 4 der Verarbeitungskette (Host-Whitelist) hängt an genau zwei Zeilen
# hier: `sniStrict: true` in den Default-Optionen, und dass es keine
# `defaultCertificate` gibt.
#
# Wirkung: Wer die Edge-VM direkt über ihre IP anspricht oder einen Hostnamen
# schickt, für den kein Zertifikat konfiguriert ist, bekommt kein Zertifikat
# angeboten - der TLS-Handshake bricht ab, bevor es eine HTTP-Anfrage gibt.
# Genau das ist im Konzept mit "Reset statt einer Antwort" gemeint. Scanner
# sehen damit auch keine Fehlerseite, aus der sich ableiten ließe, was hier
# läuft.
#
# Ohne sniStrict würde Traefik ein beliebiges konfiguriertes Zertifikat
# ausliefern und die Anfrage bis zum Router durchlassen.
#
tls:
  options:
    default:
      minVersion: ${tls_min_version}
      sniStrict: true
      curvePreferences:
        - CurveP521
        - CurveP384
      cipherSuites:
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305

    #
    # Nur TLS 1.3. Reserviert für den Fall, dass ein Dienst ohne alte Clients
    # auskommt - Immich- und Nextcloud-Apps auf älteren Telefonen tun das nicht,
    # deshalb ist das nicht der Default.
    #
    modern:
      minVersion: VersionTLS13
      sniStrict: true
      curvePreferences:
        - CurveP521
        - CurveP384
