#
# Statische Traefik-Konfiguration der Edge-VM - von Terraform gerendert aus
# vm/edge/templates/traefik/traefik.yml.tftpl nach /etc/traefik/traefik.yml.
#
# NICHT auf der VM bearbeiten. Quelle der Wahrheit ist das Repo.
#
# Deckt die Stufen 3 bis 6 der Verarbeitungskette ab
# (k8s/homelab-sicherheitskonzept.html, Abschnitt "Edge-VM"): TLS-Terminierung,
# Host-Whitelist, AppSec und Rate Limiting. Die eigentlichen Regeln stehen in
# /etc/traefik/dynamic - was sich zur Laufzeit ändern soll, gehört nicht hierher.
#

global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  websecure:
    address: ":${public_https_port}"

    #
    # Der wichtigste Block der ganzen Datei.
    #
    # trustedIPs ist leer und insecure steht auf false. Damit wirft Traefik
    # jeden vom Client mitgeschickten X-Forwarded-*-Header weg (inklusive
    # X-Real-Ip) und setzt X-Forwarded-For anschließend selbst auf die
    # TCP-Peer-Adresse - überschreiben statt anhängen.
    #
    # Der umgekehrte Fehler wäre der gefährlichere: Hängt die Edge den Wert des
    # Clients nur an, bestimmt der Angreifer per Kopfzeile, als welche IP er
    # bewertet wird, und schaltet damit die zentrale Abwehrschicht ab. Steht
    # hier je ein trustedIPs-Eintrag, muss klar sein, warum.
    #
    # Abnahme: vm/edge/verify/proxy-test.sh setzt ein gefälschtes
    # X-Forwarded-For ab und prüft, dass im Access-Log die echte Peer-IP steht.
    #
    forwardedHeaders:
      insecure: false

    http:
      #
      # Normalisierung kodierter Zeichen im Pfad. Für WebDAV der Punkt, an dem
      # Proxy und Anwendung auseinanderlaufen können ("split view") - siehe
      # entrypoint_sanitize_path in variables.tf.
      #
      sanitizePath: ${sanitize_path}

    transport:
      respondingTimeouts:
        # Großzügig wegen Foto- und Dateisynchronisation; ein 20-GB-Upload darf
        # nicht am Proxy-Timeout scheitern.
        readTimeout: ${upload_timeout}s
        writeTimeout: ${upload_timeout}s
        idleTimeout: 180s
      lifeCycle:
        graceTimeOut: 30s
%{ if http3_enabled ~}

    http3: {}
%{ endif ~}

  #
  # Diagnose ausschließlich auf dem Loopback. Beide Ports sind von außen nicht
  # erreichbar - weder über die Portfreigabe noch aus der DMZ - und tauchen
  # deshalb auch nicht im nftables-Regelsatz auf.
  #
  ping:
    address: "127.0.0.1:8081"

  metrics:
    address: "127.0.0.1:8082"

ping:
  entryPoint: ping

metrics:
  prometheus:
    entryPoint: metrics
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true

#
# Kein Docker-Provider, kein API-Dashboard: Die Edge-VM kennt keine Container
# und niemanden, der ein Dashboard aufrufen dürfte. Alles Dynamische kommt aus
# Dateien, die Terraform schreibt.
#
providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: ${log_level}
  filePath: /var/log/traefik/traefik.log
  format: json

#
# Das Access-Log ist die Datengrundlage des CrowdSec-Agenten auf dieser
# Maschine (Stufe 2). Header mit Anmeldedaten werden redigiert - die Logs
# überleben die VM und sollen keine Passwörter enthalten.
#
accessLog:
  filePath: /var/log/traefik/access.log
  format: json
  bufferingSize: 0
  fields:
    defaultMode: keep
    names:
      ClientUsername: drop
    headers:
      defaultMode: keep
      names:
        User-Agent: keep
        Referer: keep
        Content-Type: keep
        X-Forwarded-For: keep
        Authorization: redact
        Cookie: redact
        Set-Cookie: redact

#
# Ein Zertifikat je öffentlichem Namen, per DNS-01 über die delegierte
# ACME-DNS-Instanz. Kein Wildcard und kein Provider-Token: Die Edge bekommt
# Credentials für genau ihre _acme-challenge-Records und kann die produktive
# Zone nicht anfassen (Entscheidung E4 und E9 im Konzept).
#
# Die acme-dns-Kontodaten liegen in ${acme_dns_storage} und werden beim ersten
# Lauf angelegt; der zugehörige CNAME muss danach in der Zone stehen, sonst
# scheitert die Validierung. Siehe README, Abschnitt "ACME".
#
certificatesResolvers:
  acmedns:
    acme:
      email: ${acme_email}
      storage: /var/lib/traefik/acme.json
      caServer: ${acme_ca_server}
      keyType: EC256
      dnsChallenge:
        provider: acmedns
        # Öffentliche Resolver für die Propagationsprüfung - der interne
        # Resolver kennt die delegierte Zone nicht und würde die eigene, noch
        # nicht propagierte Antwort sehen.
        resolvers:
%{ for resolver in acme_check_resolvers ~}
          - "${resolver}"
%{ endfor ~}
        propagation:
          delayBeforeChecks: 30s

#
# Stufe 2 und 5: Der Bouncer prüft jede Anfrage gegen die CrowdSec-Entscheidungen
# und schickt sie zur Inhaltsprüfung an die lokale AppSec-Komponente.
# Renovate verfolgt diese Zeilen über denselben Custom-Manager wie
# traefik/config/traefik.yml.
#
experimental:
  plugins:
    crowdsec-bouncer:
      moduleName: github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin
      version: ${crowdsec_plugin_version}
