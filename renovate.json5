{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended'
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'after 2am and before 6am'
  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '(^|/)[^/]*compose[^/]*\\.ya?ml$'
    ],
  },
  dockerfile: {
    enabled: true,
    managerFilePatterns: [
      '(^|/)Dockerfile$'
    ],
  },
  // Custom Manager für Traefik Plugins
  customManagers: [
    {
      customType: 'regex',
      fileMatch: [
        '(^|/)traefik\\.ya?ml$'
      ],
      matchStrings: [
        'moduleName:\\s*github\\.com\\/(?<depName>[^\\/]+\\/[^\\s]+)\\s+version:\\s*(?<currentValue>v[^\\s]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  branchPrefix: 'renovate/',
  additionalBranchPrefix: '{{parentDir}}-',
  packageRules: [
    {
      description: 'Docker: Aktiviert und Digest-Pinning',
      matchCategories: [
        'docker'
      ],
      enabled: true,
      pinDigests: true,
    },
    // --- MANUELLE QUELL-URLS & VERSION EXTRACTION ---
    {
      description: 'Metadaten-Fix für Docker Images',
      matchDatasources: [
        'docker'
      ],
      // Extrahiert nur die Versionsnummer (z.B. v2.6.2, 17.2, 3.2.3.0) und ignoriert Suffixe wie -alpine/-apache.
      extractVersion: '^v?(?<version>[0-9]+(?:\\.[0-9]+){1,3})',
      packageRules: [
//        {
//          matchPackageNames: [
//            'adguard/adguardhome'
//          ],
//          sourceUrl: 'https://github.com/AdguardTeam/AdGuardHome'
//        },
//        {
