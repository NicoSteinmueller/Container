{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  mode: 'full',
  timezone: 'Europe/Berlin',
//  schedule: [
//    'after 2am and before 6am',
//  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '(^|/)[^/]*compose[^/]*\\.ya?ml$',
    ],
  },
  // Reine Kubernetes-Manifeste unter k8s/flux (Deployments ohne Chart,
  // z.B. apps/ntfy). HelmReleases deckt der flux-Manager ab.
  kubernetes: {
    managerFilePatterns: [
      '/^k8s\\/flux\\/.+\\.ya?ml$/',
    ],
  },
  // HelmReleases und GitRepository-Tags unter k8s/flux. Ohne eigenes Muster
  // sucht der flux-Manager nur nach gotk-components.yaml und findet hier
  // nichts.
  flux: {
    managerFilePatterns: [
      '/^k8s\\/flux\\/.+\\.ya?ml$/',
    ],
  },
  dockerfile: {
    enabled: true,
    managerFilePatterns: [
      '(^|/)Dockerfile$',
    ],
  },
  customManagers: [
    {
      // Traefik-Plugins: im Docker-Stack als Umgebungsvariablen
      // (traefik/compose.yml), im Cluster im plugins-Block des HelmRelease.
      customType: 'regex',
      managerFilePatterns: [
        '/^traefik\\/compose\\.ya?ml$/',
        '/^k8s\\/flux\\/network\\/ingress-[^/]+\\/HelmRelease\\.ya?ml$/',
      ],
      matchStrings: [
        'TRAEFIK_EXPERIMENTAL_PLUGINS_[A-Z0-9_-]+_MODULENAME:\\s*"?github\\.com\\/(?<depName>[^\\/\\s"]+\\/[^\\s"]+)"?\\s+TRAEFIK_EXPERIMENTAL_PLUGINS_[A-Z0-9_-]+_VERSION:\\s*"?(?<currentValue>v[^\\s"]+)"?',
        'moduleName:\\s*github\\.com\\/(?<depName>[^\\/]+\\/[^\\s]+)\\s+version:\\s*(?<currentValue>v[^\\s]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      // Chart- und Image-Versionen mit `# renovate:`-Kommentar direkt
      // darüber: die Flux-Charts im Bootstrap (k8s/bootstrap/variables.tf) und
      // Images in HelmRelease-Values, die als repository/tag getrennt stehen.
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/bootstrap\\/variables\\.tf$/',
        '/^k8s\\/flux\\/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+(?:default\\s*=|\\w+:)\\s*"?(?<currentValue>[^"\\s]+)"?',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)ansible\\/minikube-install\\.ya?ml$/',
      ],
      matchStrings: [
        'minikube_release_version:\\s*"(?<currentValue>v[^"]+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes/minikube',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)ansible\\/minikube-install\\.ya?ml$/',
      ],
      matchStrings: [
        'kubectl_release_version:\\s*"(?<currentValue>v[^"]+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes/kubernetes',
    },
    {
      // Gepinnte Release-Binaries der Tool-Rollen
      // (ansible/tools/roles/<tool>/defaults/main.yml). Fuer diese Sorte gibt
      // es kein apt-Repository, das unattended-upgrades bedienen koennte -
      // dieser Manager *ist* ihr Update-Kanal, zusammen mit dem naechsten
      // Playbook-Lauf. Siehe ansible/tools/README.md.
      //
      // Bewusst generisch ueber alle Rollen: Datasource und Repo stehen als
      // Kommentar an der Version selbst, damit eine neue Rolle hier nichts
      // nachtragen muss. Die Pruefsumme zieht die Rolle zur Laufzeit aus dem
      // Release - hier ist nichts von Hand nachzuziehen.
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)ansible\\/tools\\/roles\\/[^/]+\\/defaults\\/main\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+\\w+_version:\\s*(?<currentValue>\\S+)',
      ],
    },
    {
      // Talos Linux des Prod-Nodes (vm/talos/variables.tf). Ein Update ist
      // hier kein Merge, sondern ein Wartungsfenster: `talosctl upgrade` mit
      // der Schematic-ID aus dem Output - siehe vm/talos/README.md.
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)vm\\/talos\\/variables\\.tf$/',
      ],
      matchStrings: [
        'variable "talos_version"[\\s\\S]*?default\\s*=\\s*"(?<currentValue>v[0-9.]+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'siderolabs/talos',
    },
    {
      // Kubernetes-Version im Cluster. Talos gibt vor, welche Stände zu einer
      // Talos-Version passen - der Wert wird deshalb nicht automatisch
      // gemergt.
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)vm\\/talos\\/variables\\.tf$/',
      ],
      matchStrings: [
        'variable "kubernetes_version"[\\s\\S]*?default\\s*=\\s*"(?<currentValue>[0-9.]+)"',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes/kubernetes',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      // Cilium. Wird als Inline-Manifest in die Machine-Config gerendert -
      // ein Update ist ein `terraform apply` auf vm/talos, kein
      // helm upgrade.
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)vm\\/talos\\/variables\\.tf$/',
      ],
      matchStrings: [
        'variable "cilium_version"[\\s\\S]*?default\\s*=\\s*"(?<currentValue>[0-9.]+)"',
      ],
      datasourceTemplate: 'helm',
      depNameTemplate: 'cilium',
      registryUrlTemplate: 'https://helm.cilium.io',
    },
    {
      // Postgres-Image der CNPG-Cluster (`imageName`) und ihrer Dump- und
      // Restore-Jobs (`image`), Vorlage in k8s/templates/CnpgDatabase.yaml.
      // Beide Stellen einer Datei müssen gleich bleiben - pg_dump bricht gegen
      // eine neuere Server-Hauptversion ab. Ein Manager für beide Stellen,
      // damit sie im selben PR wandern.
      //
      // Die Versionierung hält das Suffix (`standard-trixie`) fest und lässt
      // die Zeitstempel-Tags (`18.4-2026…-standard-trixie`) außen vor.
      customType: 'regex',
      managerFilePatterns: [
        '/^k8s\\/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '(?<depName>ghcr\\.io\\/cloudnative-pg\\/postgresql):(?<currentValue>\\d+\\.\\d+-[a-z]+-[a-z]+)@(?<currentDigest>sha256:[a-f0-9]{64})',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<compatibility>[a-z]+-[a-z]+)$',
      autoReplaceStringTemplate: '{{depName}}:{{newValue}}@{{newDigest}}',
    },
  ],
  branchPrefix: 'renovate/',
  additionalBranchPrefix: '{{parentDir}}-',
  packageRules: [
    {
      description: 'Docker: Aktiviert und Digest-Pinning',
      matchCategories: [
        'docker',
      ],
      enabled: true,
      pinDigests: true,
    },
    {
      description: 'Metadaten-Fix für Docker Images',
      matchDatasources: [
        'docker',
      ],
      extractVersion: '^v?(?<version>[0-9]+(?:\\.[0-9]+){1,3})',
      matchPackageNames: [
        'grafana/grafana',
      ],
      sourceUrl: 'https://github.com/grafana/grafana',
    },
    {
      description: 'Metadaten-Fix für Docker Images',
      matchDatasources: [
        'docker',
      ],
      extractVersion: '^v?(?<version>[0-9]+(?:\\.[0-9]+){1,3})',
      matchPackageNames: [
        'traefik',
        'docker.io/library/traefik',
      ],
      sourceUrl: 'https://github.com/traefik/traefik',
    },
    {
      description: 'Alle Non-Major Updates: Automatische PRs mit sofortigem Automerge',
      matchUpdateTypes: [
        'patch',
        'minor',
        'pin',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      prCreation: 'immediate',
      ignoreTests: true,
      prBodyNotes: [
        '{{#if releases}}### 🧾 Versionsdetails\n\n{{#each releases}}- {{#if url}}[{{version}}]({{{url}}}){{else}}{{version}}{{/if}}\n{{/each}}{{/if}}',
      ],
    },
    {
      description: 'Major-Updates: PR mit Review erforderlich',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      prBodyNotes: [
        '### ⚠️ Major Update - Breaking Changes möglich\n\n{{#if releases}}{{#each releases}}#### {{#if url}}[{{version}}]({{{url}}}){{else}}Version {{version}}{{/if}}\n{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}\n{{#if body}}\n\n{{{body}}}\n\n{{/if}}{{/each}}{{else}}Keine detaillierten Release Notes gefunden. Bitte manuell prüfen.{{/if}}',
      ],
    },
    {
      description: 'Datenbanken Major-Updates: PR mit Review (Kompatibilität prüfen!)',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      groupName: null,
      prBodyNotes: [
        '### 🗄️ Datenbank Major-Update - Kompatibilität prüfen!\n\n⚠️ **Vor dem Merge prüfen:**\n- Backup vorhanden?\n- Breaking Changes im Datenformat?\n\n{{#if releases}}{{#each releases}}#### {{#if url}}[{{version}}]({{{url}}}){{else}}Version {{version}}{{/if}}\n{{/each}}{{/if}}',
      ],
      matchPackageNames: [
        '/(?:^|/)postgres$/',
        '/(?:^|/)mariadb$/',
        '/(?:^|/)mysql$/',
        '/(?:^|/)redis$/',
        '/(?:^|/)mongo$/',
        '/(?:^|/)valkey$/',
        '/(?:^|/)memcached$/',
      ],
    },
    {
      // Gelernt an helm 3.x und kubernetes 3.x: Der Merge ging durch, der
      // Fehler kam erst beim nächsten plan, als niemand mehr an den PR dachte.
      description: 'Terraform-Provider Major: vor dem Merge plan auf dem Branch',
      matchManagers: [
        'terraform',
      ],
      matchUpdateTypes: [
        'major',
      ],
      prBodyNotes: [
        '### 🧱 Major-Update eines Terraform-Providers\n\n⚠️ **Vor dem Merge `tf plan` auf diesem Branch.** Ein Provider-Major ändert oft Syntax oder Ressourcentypen - der Merge zeigt das nicht, der Fehler kommt erst beim nächsten `plan` (so geschehen bei helm 3.x: `kubernetes { }` wurde zum Attribut `kubernetes = { }`; kubernetes 3.x: Ressourcen ohne `_v1` deprecated).\n\n```bash\ngit fetch origin\ngit switch --detach origin/{{{branchName}}}\ncd {{{packageFileDir}}}\n../../tools/tf init\n../../tools/tf plan\ngit switch -\n```\n\nDer Plan muss ohne `destroy` auskommen. Benennt der Provider Ressourcentypen um: `moved` geht beim kubernetes-Provider nicht über Typgrenzen (\"Move Resource State Not Supported\") - stattdessen `removed` mit `destroy = false` plus `import`, nach dem `apply` wieder entfernen.',
      ],
    },
    {
      description: 'OctoPrint: IMMER PR mit Review (manuelle Prüfung erforderlich)',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'octoprint/octoprint',
      ],
      automerge: false,
      prCreation: 'immediate',
      prBodyNotes: [
        '### 🖨️ OctoPrint Update - Manuelle Prüfung erforderlich!\n\n{{#if releases}}{{#each releases}}#### {{#if url}}[{{version}}]({{{url}}}){{else}}Version {{version}}{{/if}}\n{{/each}}{{/if}}',
      ],
    },
    {
      description: 'Traefik Plugins: IMMER PR (manuelle Deployment erforderlich)',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'traefik/compose.yml',
      ],
      automerge: false,
      prCreation: 'immediate',
      prBodyNotes: [
        '### 🔌 Traefik Plugin Update\n\n⚠️ **WICHTIG: Manuelles Deployment erforderlich!**\n\n{{#if releases}}{{#each releases}}#### {{#if url}}[{{version}}]({{{url}}}){{else}}Version {{version}}{{/if}}\n{{/each}}{{/if}}',
      ],
    },
    {
      description: 'Traefik Plugins im Cluster: der Hash zieht nicht mit, ohne ihn startet Traefik nicht',
      matchManagers: [
        'custom.regex',
      ],
      matchDatasources: [
        'github-releases',
      ],
      matchFileNames: [
        'k8s/flux/network/ingress-*/HelmRelease.yaml',
      ],
      automerge: false,
      prCreation: 'immediate',
      prBodyNotes: [
        '### 🔌 Traefik Plugin im Cluster - Hash nachtragen!\n\n🛑 **Nicht so mergen.** Renovate hebt nur `version`, der `hash` daneben bleibt alt. Mit `abortOnPluginFailure: true` startet Traefik dann nicht mehr - der öffentliche Ingress ist weg.\n\nVor dem Merge im PR-Branch den Hash ersetzen:\n\n```bash\ncurl -sL https://plugins.traefik.io/public/download/github.com/{{{depName}}}/{{{newVersion}}} | sha256sum\n```',
      ],
    },
    {
      description: 'Talos-Node: Update immer mit Review, Upgrade ist ein Wartungsfenster',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'vm/talos/variables.tf',
      ],
      automerge: false,
      prCreation: 'immediate',
      prBodyNotes: [
        '### ☸️ Update des Talos-Nodes\n\n⚠️ **Ein Merge allein ändert nichts.** Bei `talos_version` / `kubernetes_version` gilt: **erst der Node, dann `tf apply`** – der Apply schreibt eine Config, die die neue Version voraussetzt; ein Node auf der alten lehnt sie ab (`… not registered`). Nur `cilium_version`: der Apply allein genügt.\n\n```bash\n# vorher talosctl auf den neuen Pin bringen (ansible/tools)\ncd vm/talos\ntalosctl etcd snapshot db.snapshot\ntalosctl -n <lan_ip> upgrade --drain=false \\\n  --image "factory.talos.dev/metal-installer/$(../../tools/tf output -raw schematic_id):<talos_version>"\ntalosctl -n <lan_ip> upgrade-k8s --to <kubernetes_version>   # nur bei kubernetes_version\n../../tools/tf apply                                          # baut die VM nicht neu\n```\n\n- **`--drain=false`:** Single-Node – der Drain hängt sonst am PDB von CNPG und lässt einen abgesperrten Node zurück (dann `kubectl uncordon`). `--preserve` ist seit 1.14 nur noch Legacy.\n- **Image nicht aus `tf output installer_image`:** der steht bis zum Apply noch auf der alten Version. Die Schematic-ID muss bleiben, sonst verschwinden die System-Extensions.\n- **`machine_config_contract` nicht mitheben** – siehe vm/talos/README.md, Abschnitt Updates.\n\nDanach prüfen:\n\n```bash\ntalosctl health\nkubectl get nodes -o wide\nkubectl -n kube-system exec ds/cilium -- cilium-dbg status --brief\n```',
      ],
    },
    {
      // talosctl, der Node, der Terraform-Provider und Kubernetes müssen
      // zueinander passen: Kubernetes 1.x läuft erst auf einem Talos, das es
      // kennt, und talosctl soll den Stand des Nodes haben. Einzeln
      // automatisch gemergt lief talosctl dem Node schon davon.
      //
      // additionalBranchPrefix leer, sonst landet jedes Verzeichnis ({{parentDir}})
      // trotz gleicher Gruppe in einem eigenen Branch.
      description: 'Talos-Stack: Node, talosctl, Provider und Kubernetes in einem PR, nie automatisch',
      matchFileNames: [
        'vm/talos/variables.tf',
        'vm/talos/main.tf',
        'ansible/tools/roles/talosctl/defaults/main.yml',
      ],
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
      ],
      groupName: 'talos',
      additionalBranchPrefix: '',
      automerge: false,
      prCreation: 'immediate',
    },
    {
      description: 'Flux-Bootstrap: Operator, Instance und Distribution gemeinsam, wirkt erst mit apply',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'k8s/bootstrap/variables.tf',
      ],
      groupName: 'flux-bootstrap',
      automerge: false,
      prCreation: 'immediate',
      prBodyNotes: [
        '### 🔁 Flux selbst\n\n⚠️ **Ein Merge allein ändert nichts** - die Versionen stehen im Bootstrap-Modul, nicht unter `k8s/flux`. Ausgerollt wird mit:\n\n```bash\ncd k8s/bootstrap\n../../tools/tf plan\n../../tools/tf apply\n```\n\nOperator- und Instance-Chart gleich halten. Eine neue `flux_version` braucht einen Operator, der sie kennt - deshalb im selben PR.\n\nDanach prüfen:\n\n```bash\nkubectl -n flux-system get fluxinstance\nkubectl -n flux-system get kustomization\n```',
      ],
    },
    {
      // Automerge wie überall über die Regeln für Non-Major/Major oben: Hier
      // ist der Merge schon das Ausrollen, es bleibt nichts von Hand zu tun.
      // Ausnahmen mit Handarbeit (Plugin-Hash, Bootstrap) stehen eigens.
      description: 'Cluster-Ausstattung: HelmReleases, Flux rollt nach dem Merge selbst aus',
      matchManagers: [
        'flux',
      ],
      prCreation: 'immediate',
      prBodyNotes: [
        '### 🧩 Update eines HelmRelease\n\nAnders als bei den Terraform-Modulen genügt hier der Merge: Flux zieht die neue Version von selbst nach, ein `apply` gibt es nicht. Non-Major-Updates laufen deshalb automatisch durch; bei Major-Updates und Minor-Sprüngen unter 0.x ist der Review die einzige Stelle, an der ein Breaking Change auffallen kann.\n\nNach dem Merge:\n\n```bash\nkubectl -n flux-system get helmrelease\nkubectl -n flux-system get kustomization\n```\n\nHängt eines auf `False`, steht der Grund in `kubectl -n flux-system describe helmrelease <name>`.',
      ],
    },
    {
      description: 'Kubernetes-Manifeste: wie die HelmReleases, Flux rollt nach dem Merge selbst aus',
      matchManagers: [
        'kubernetes',
      ],
      prCreation: 'immediate',
    },
    {
      // SemVer: Unter 0.x darf schon ein Minor-Sprung brechen - und genau so
      // versionieren mehrere Charts hier (cloudnative-pg, crowdsec, headlamp).
      // Für Renovate ist 0.29 -> 0.30 trotzdem "minor" und fiele unter den
      // Automerge. Patches unter 0.x laufen weiter automatisch.
      //
      // Nur Charts und Git-Quellen (flux-Manager), nicht die Images in den
      // Manifesten: navidrome etwa ist seit Jahren 0.x, und im Docker-Stack
      // läuft dasselbe Update ohnehin automatisch.
      description: 'Cluster: Chart-Minor-Updates unter 0.x mit Review, sie dürfen brechen',
      matchManagers: [
        'flux',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      matchCurrentVersion: '/^v?0\\./',
      automerge: false,
    },
    {
      description: 'CNPG-Postgres nicht doppelt: das hebt der eigene Regex-Manager, Instanz und Dump-Job gemeinsam',
      matchManagers: [
        'kubernetes',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      enabled: false,
    },
    {
      // Minor und Digest laufen automatisch durch: CNPG startet die Instanz
      // selbst neu (kurze Downtime, `instances: 1`), zu tun bleibt nichts.
      // Ein Major bleibt über die Major-Regel oben beim Review.
      description: 'CNPG-Postgres: Instanz und Dump-Job gemeinsam, Major mit Review',
      matchManagers: [
        'custom.regex',
      ],
      matchPackageNames: [
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      groupName: 'cnpg-postgres',
      prCreation: 'immediate',
      prBodyNotes: [
        '### 🐘 Postgres im Cluster\n\nInstanz und Dump-Job wechseln gemeinsam - `pg_dump` bricht gegen eine neuere Server-Hauptversion ab. Nach dem Merge startet CNPG die Instanz neu (kurze Downtime, `instances: 1`).\n\n**Major-Update (kein Automerge):** CNPG macht daraus ein `pg_upgrade` beim Start. Vorher einen frischen Dump ziehen:\n\n```bash\nkubectl -n <ns> create job --from=cronjob/<name>-db-dump dump-vor-upgrade\n```\n\nDanach prüfen: `kubectl -n <ns> get cluster` (healthy) und einen Dump-Job laufen lassen.',
      ],
    },
    {
      description: 'Tool-Binaries: Der Merge installiert noch nichts',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'ansible/tools/roles/**',
      ],
      prBodyNotes: [
        '### 🧰 Gepinnte Tool-Binary\n\nDer Merge hebt nur den Pin. Eingespielt wird er beim nächsten Lauf:\n\n```bash\ncd ansible/tools\nansible-playbook -i inventory.ini tools.yml\n```\n\nDie Prüfsumme zieht die Rolle selbst aus dem Release – hier ist nichts von Hand nachzutragen.',
      ],
    },
    {
      description: 'Docker Compose Updates - Gruppierung',
      matchManagers: [
        'docker-compose',
      ],
      groupName: '{{parentDir}}',
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessagePrefix: '[{{parentDir}}]',
    },
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  platformAutomerge: false,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: '🔄 Renovate Dashboard - Docker Updates',
  fetchChangeLogs: 'pr',
  prBodyDefinitions: {
    Change: '{{#if displayFrom}}{{displayFrom}} → {{/if}}{{#if releaseNotesUrl}}[{{displayTo}}]({{{releaseNotesUrl}}}){{else}}{{#if changelogUrl}}[{{displayTo}}]({{{changelogUrl}}}){{else}}{{#if sourceUrl}}[{{displayTo}}]({{{sourceUrl}}}/releases){{else}}{{displayTo}}{{/if}}{{/if}}{{/if}}{{#if compareUrl}}<br/>[Compare]({{{compareUrl}}}){{/if}}',
  },
}
