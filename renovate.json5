{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'after 2am and before 6am',
  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)docker-compose\\.ya?ml$/',
      '/(^|/)docker-compose\\.shared\\.ya?ml$/',
    ],
  },
  // Custom Manager für Traefik Plugins
  customManagers: [
    {
      customType: 'regex',
      fileMatch: [
        '(^|/)traefik\\.ya?ml$',
      ],
      matchStrings: [
        'moduleName:\\s*github\\.com\\/(?<depName>[^\\/]+\\/[^\\s]+)\\s+version:\\s*(?<currentValue>v[^\\s]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  // Branch-Naming: Enthält den Ordnernamen (z.B. renovate/immich-postgres-17.x)
  branchPrefix: 'renovate/',
  additionalBranchPrefix: '{{parentDir}}-',
  packageRules: [
    {
      description: 'Docker: Aktiviert und Digest-Pinning',
      matchCategories: [
        'docker',
      ],
      enabled: true,
      pinDigests: true,
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'adguard/adguardhome',
      ],
      sourceUrl: 'https://github.com/AdguardTeam/AdGuardHome',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'apache/tika',
      ],
      sourceUrl: 'https://github.com/apache/tika',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'crowdsecurity/crowdsec',
      ],
      sourceUrl: 'https://github.com/crowdsecurity/crowdsec',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'docker.io/valkey/valkey',
        'valkey/valkey',
      ],
      sourceUrl: 'https://github.com/valkey-io/valkey',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'drakkan/sftpgo',
      ],
      sourceUrl: 'https://github.com/drakkan/sftpgo',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/immich-app/immich-machine-learning',
        'ghcr.io/immich-app/immich-server',
      ],
      sourceUrl: 'https://github.com/immich-app/immich',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/immich-app/postgres',
      ],
      sourceUrl: 'https://github.com/immich-app/base-images',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/paperless-ngx/paperless-ngx',
      ],
      sourceUrl: 'https://github.com/paperless-ngx/paperless-ngx',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/sharevb/it-tools',
      ],
      sourceUrl: 'https://github.com/CorentinTh/it-tools',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gotenberg/gotenberg',
      ],
      sourceUrl: 'https://github.com/gotenberg/gotenberg',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'grafana/grafana',
      ],
      sourceUrl: 'https://github.com/grafana/grafana',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'grafana/loki',
        'grafana/promtail',
      ],
      sourceUrl: 'https://github.com/grafana/loki',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'itzg/minecraft-server',
      ],
      sourceUrl: 'https://github.com/itzg/docker-minecraft-server',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'kopia/kopia',
      ],
      sourceUrl: 'https://github.com/kopia/kopia',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'nextcloud',
        'docker.io/library/nextcloud',
      ],
      sourceUrl: 'https://github.com/nextcloud/server',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'octoprint/octoprint',
      ],
      sourceUrl: 'https://github.com/OctoPrint/OctoPrint',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'postgres',
        'docker.io/library/postgres',
      ],
      sourceUrl: 'https://github.com/postgres/postgres',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'prom/prometheus',
      ],
      sourceUrl: 'https://github.com/prometheus/prometheus',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'quay.io/keycloak/keycloak',
      ],
      sourceUrl: 'https://github.com/keycloak/keycloak',
    },
    {
      description: 'Manuelle Quell-URLs für Docker-Images ohne Metadaten',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'traefik',
        'docker.io/library/traefik',
      ],
      sourceUrl: 'https://github.com/traefik/traefik',
    },
    {
      description: 'Alle Non-Major Updates: Automatische PRs mit sofortigem Automerge',
      matchUpdateTypes: [
        'patch',
        'minor',
        'pin',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      prCreation: 'immediate',
      prBodyNotes: [
        "{{#if releases}}### 🧾 Versionsdetails\n\n{{#each releases}}- {{#if url}}[{{version}}]({{{url}}}){{else}}{{version}}{{/if}}\n{{/each}}{{/if}}"
      ],
      // In diesem Repo gibt es derzeit keine verlässlichen Status-Checks.
      // Dadurch bleiben Updates nicht mehr in "Pending Branch Automerge" hängen.
      ignoreTests: true,
    },
    {
      description: 'Major-Updates: PR mit Review erforderlich',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      prBodyNotes: [
        "### ⚠️ Major Update - Breaking Changes möglich\n\n{{#if releases}}\n{{#each releases}}\n#### Version {{version}}\n{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}\n{{#if body}}\n\n{{{body}}}\n\n{{/if}}\n{{/each}}\n{{/if}}",
      ],
    },
    {
      description: 'Datenbanken Major-Updates: PR mit Review (Kompatibilität prüfen!)',
      matchDatasources: [
        'docker',
      ],
      matchPackagePatterns: [
        '(?:^|/)postgres$',
        '(?:^|/)mariadb$',
        '(?:^|/)mysql$',
        '(?:^|/)redis$',
        '(?:^|/)mongo$',
        '(?:^|/)valkey$',
        '(?:^|/)memcached$',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      groupName: null, // Nicht mit anderen gruppieren
      prBodyNotes: [
        "### 🗄️ Datenbank Major-Update - Kompatibilität prüfen!\n\n⚠️ **Vor dem Merge prüfen:**\n- Ist diese DB-Version mit der Anwendung kompatibel?\n- Gibt es Breaking Changes im Datenformat?\n- Backup vorhanden?\n\n{{#if releases}}\n{{#each releases}}\n#### Version {{version}}\n{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}\n{{#if body}}\n\n{{{body}}}\n\n{{/if}}\n{{/each}}\n{{/if}}",
      ],
    },
    {
      description: 'Traefik Plugins: IMMER PR (manuelle Deployment erforderlich)',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'traefik/config/traefik.yml',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      prBodyNotes: [
        "### 🔌 Traefik Plugin Update\n\n⚠️ **WICHTIG: Manuelles Deployment erforderlich!**\n\n📋 **Checkliste:**\n- [ ] Release Notes auf Breaking Changes prüfen\n- [ ] Config auf Server kopieren\n- [ ] Traefik neu starten\n- [ ] Funktionalität testen\n\n{{#if releases}}\n{{#each releases}}\n#### Version {{version}}\n{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}\n{{#if body}}\n\n{{{body}}}\n\n{{/if}}\n{{/each}}\n{{/if}}",
      ],
    },
    {
      description: 'Docker Compose Updates - pro Ordner gruppiert',
      matchManagers: [
        'docker-compose',
      ],
      groupName: '{{parentDir}}',
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessagePrefix: '[{{parentDir}}]',
    },
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  // Renovate merged selbst, statt auf GitHub Auto-Merge / branchbasierte Status-Checks zu warten.
  platformAutomerge: false,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: '🔄 Renovate Dashboard - Docker Updates',
  // Release Notes in allen PRs anzeigen
  fetchReleaseNotes: true,
  // Change-Spalte: Zielversion als Link, Compare-Link in zweiter Zeile
  prBodyDefinitions: {
    Change: '{{#if displayFrom}}{{displayFrom}} → {{/if}}{{#if releaseNotesUrl}}[{{displayTo}}]({{{releaseNotesUrl}}}){{else}}{{#if changelogUrl}}[{{displayTo}}]({{{changelogUrl}}}){{else}}{{displayTo}}{{/if}}{{/if}}{{#if compareUrl}}<br/>[Compare]({{{compareUrl}}}){{/if}}',
  },
}
