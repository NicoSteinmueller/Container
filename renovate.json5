{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'after 2am and before 6am',
  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)docker-compose\\.ya?ml$/',
    ],
  },
  // Custom Manager für Traefik Plugins
  customManagers: [
    {
      customType: 'regex',
      fileMatch: [
        '(^|/)traefik\\.ya?ml$',
      ],
      matchStrings: [
        'moduleName:\\s*github\\.com\\/(?<depName>[^\\/]+\\/[^\\s]+)\\s+version:\\s*(?<currentValue>v[^\\s]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  // Branch-Naming: Enthält den Ordnernamen (z.B. renovate/immich-postgres-17.x)
  branchPrefix: 'renovate/',
  additionalBranchPrefix: '{{parentDir}}-',
  packageRules: [
    {
      description: 'Docker: Aktiviert und Digest-Pinning',
      matchCategories: [
        'docker',
      ],
      enabled: true,
      pinDigests: true,
    },
    {
      description: 'Alle Non-Major Updates: Automatische PRs mit sofortigem Automerge',
      matchUpdateTypes: [
        'patch',
        'minor',
        'pin',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      prCreation: 'immediate',
      prBodyNotes: [
        "{{#if releases}}### 🧾 Versionsdetails\n\n{{#each releases}}- {{#if url}}[{{version}}]({{{url}}}){{else}}{{version}}{{/if}}\n{{/each}}{{/if}}"
      ],
      // In diesem Repo gibt es derzeit keine verlässlichen Status-Checks.
      // Dadurch bleiben Updates nicht mehr in "Pending Branch Automerge" hängen.
      ignoreTests: true,
    },
    {
      description: 'Major-Updates: PR mit Review erforderlich',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      prBodyNotes: [
        '### ⚠️ Major Update - Breaking Changes möglich',
        '',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### Version {{version}}',
        '{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}',
        '{{#if body}}',
        '',
        '{{{body}}}',
        '',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
    },
    {
      description: 'Datenbanken Major-Updates: PR mit Review (Kompatibilität prüfen!)',
      matchDatasources: [
        'docker',
      ],
      matchPackagePatterns: [
        '(?:^|/)postgres$',
        '(?:^|/)mariadb$',
        '(?:^|/)mysql$',
        '(?:^|/)redis$',
        '(?:^|/)mongo$',
        '(?:^|/)valkey$',
        '(?:^|/)memcached$',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      groupName: null, // Nicht mit anderen gruppieren
      prBodyNotes: [
        '### 🗄️ Datenbank Major-Update - Kompatibilität prüfen!',
        '',
        '⚠️ **Vor dem Merge prüfen:**',
        '- Ist diese DB-Version mit der Anwendung kompatibel?',
        '- Gibt es Breaking Changes im Datenformat?',
        '- Backup vorhanden?',
        '',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### Version {{version}}',
        '{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}',
        '{{#if body}}',
        '',
        '{{{body}}}',
        '',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
    },
    {
      description: 'Traefik Plugins: IMMER PR (manuelle Deployment erforderlich)',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'traefik/config/traefik.yml',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      prBodyNotes: [
        '### 🔌 Traefik Plugin Update',
        '',
        '⚠️ **WICHTIG: Manuelles Deployment erforderlich!**',
        '',
        '📋 **Checkliste:**',
        '- [ ] Release Notes auf Breaking Changes prüfen',
        '- [ ] Config auf Server kopieren',
        '- [ ] Traefik neu starten',
        '- [ ] Funktionalität testen',
        '',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### Version {{version}}',
        '{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}',
        '{{#if body}}',
        '',
        '{{{body}}}',
        '',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
    },
    {
      description: 'Docker Compose Updates - pro Ordner gruppiert',
      matchManagers: [
        'docker-compose',
      ],
      groupName: '{{parentDir}}',
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessagePrefix: '[{{parentDir}}]',
    },
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  // Renovate merged selbst, statt auf GitHub Auto-Merge / branchbasierte Status-Checks zu warten.
  platformAutomerge: false,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: '🔄 Renovate Dashboard - Docker Updates',
  // Release Notes in allen PRs anzeigen
  fetchReleaseNotes: true,
  // Change-Spalte: Zielversion als Link, Compare-Link in zweiter Zeile
  prBodyDefinitions: {
    Change: '{{#if displayFrom}}{{displayFrom}} → {{/if}}{{#if releaseNotesUrl}}[{{displayTo}}]({{{releaseNotesUrl}}}){{else}}{{#if changelogUrl}}[{{displayTo}}]({{{changelogUrl}}}){{else}}{{displayTo}}{{/if}}{{/if}}{{#if compareUrl}}<br/>[Compare]({{{compareUrl}}}){{/if}}',
  },
}
