{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'after 2am and before 6am',
  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)docker-compose\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      enabled: true,
      pinDigests: true,
    },
    {
      description: 'Patch-Updates: Vollautomatisch ohne PR',
      matchUpdateTypes: [
        'patch',
      ],
      enabled: true,
      automerge: true,
      automergeType: 'branch',
      platformAutomerge: true,
      reviewersFromCodeOwners: false,
      assigneesFromCodeOwners: false,
      minimumReleaseAge: '0 days',
      internalChecksFilter: 'strict',
      prCreation: 'not-pending',
      groupName: null,
    },
    {
      description: 'Digest-Updates: Vollautomatisch ohne PR',
      matchUpdateTypes: [
        'digest',
      ],
      enabled: true,
      automerge: true,
      automergeType: 'branch',
      platformAutomerge: true,
      reviewersFromCodeOwners: false,
      assigneesFromCodeOwners: false,
      minimumReleaseAge: '0 days',
      internalChecksFilter: 'strict',
      prCreation: 'not-pending',
      groupName: null,
    },
    {
      description: 'Minor-Updates: Automerge nach Genehmigung',
      matchUpdateTypes: [
        'minor',
      ],
      enabled: true,
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
      prBodyNotes: [
        '### Release Notes',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### {{title}}',
        '{{#if url}}[Release]({{{url}}}){{/if}}',
        '{{#if body}}',
        '{{{body}}}',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
    },
    {
      description: 'Major-Updates: Manuelle Review erforderlich',
      matchUpdateTypes: [
        'major',
      ],
      enabled: true,
      automerge: false,
      prBodyNotes: [
        '### ⚠️ Breaking Changes',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### {{title}}',
        '{{#if url}}[Release]({{{url}}}){{/if}}',
        '{{#if body}}',
        '{{{body}}}',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
    },
    {
      description: 'Docker Compose Updates - pro Ordner gruppiert',
      matchManagers: [
        'docker-compose',
      ],
      groupName: '{{parentDir}}',
      additionalBranchPrefix: '{{parentDir}}-',
    },
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  automerge: false,
  platformAutomerge: true,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: '🔄 Renovate Dashboard - Docker Updates',
  reviewersFromCodeOwners: true,
  assigneesFromCodeOwners: true,
}
