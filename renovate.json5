{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'after 2am and before 6am',
  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)docker-compose\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchCategories: [
        'docker',
      ],
      enabled: true,
      pinDigests: true,
    },
    {
      description: 'Patch-Updates: Automerge aktiviert',
      matchUpdateTypes: [
        'patch',
      ],
      enabled: true,
      automerge: false,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      description: 'Digest-Updates: Automerge aktiviert',
      matchUpdateTypes: [
        'digest',
      ],
      enabled: true,
      automerge: false,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      description: 'Minor-Updates: Manuelle Review erforderlich',
      matchUpdateTypes: [
        'minor',
      ],
      enabled: true,
      automerge: false,
      groupName: null,
    },
    {
      description: 'Major-Updates: Manuelle Review erforderlich',
      matchUpdateTypes: [
        'major',
      ],
      enabled: true,
      automerge: false,
      groupName: null,
    },
    {
      description: 'Backrest Updates - ein PR pro Datei',
      matchFileNames: [
        'backrest/docker-compose.yml',
      ],
      groupName: null,
      additionalBranchPrefix: 'backrest-',
    },
    {
      description: 'Immich Updates - ein PR pro Datei',
      matchFileNames: [
        'immich/docker-compose.yml',
      ],
      groupName: null,
      additionalBranchPrefix: 'immich-',
    },
    {
      description: 'Keycloak Updates - ein PR pro Datei',
      matchFileNames: [
        'keycloak/docker-compose.yml',
      ],
      groupName: null,
      additionalBranchPrefix: 'keycloak-',
    },
    {
      description: 'Kopia Updates - ein PR pro Datei',
      matchFileNames: [
        'kopia/docker-compose.yml',
      ],
      groupName: null,
      additionalBranchPrefix: 'kopia-',
    },
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  automerge: false,
  platformAutomerge: true,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: '🔄 Renovate Dashboard - Docker Updates',
  reviewersFromCodeOwners: true,
  assigneesFromCodeOwners: true,
}
