{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'after 2am and before 6am',
  ],
  'docker-compose': {
    enabled: true,
    managerFilePatterns: [
      '/(^|/)docker-compose\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)traefik\\.ya?ml$/',
      ],
      matchStrings: [
        'moduleName:\\s*github\\.com\\/(?<depName>[^\\/]+\\/[^\\s]+)\\s+version:\\s*(?<currentValue>v[^\\s]+)',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],
  branchPrefix: 'renovate/',
  additionalBranchPrefix: '{{parentDir}}-',
  packageRules: [
    {
      description: 'Docker: Aktiviert und Digest-Pinning',
      matchCategories: [
        'docker',
      ],
      enabled: true,
      pinDigests: true,
    },
    {
      description: 'Alle Non-Major Updates: Automatisches Mergen',
      matchUpdateTypes: [
        'patch',
        'minor',
        'pin',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      platformAutomerge: true,
    },
    {
      description: 'Major-Updates: PR mit Review erforderlich',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      prBodyNotes: [
        '### ⚠️ Major Update - Breaking Changes möglich',
        '',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### Version {{version}}',
        '{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}',
        '{{#if body}}',
        '',
        '{{{body}}}',
        '',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
    },
    {
      description: 'Datenbanken Major-Updates: PR mit Review (Kompatibilität prüfen!)',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      groupName: null,
      prBodyNotes: [
        '### 🗄️ Datenbank Major-Update - Kompatibilität prüfen!',
        '',
        '⚠️ **Vor dem Merge prüfen:**',
        '- Ist diese DB-Version mit der Anwendung kompatibel?',
        '- Gibt es Breaking Changes im Datenformat?',
        '- Backup vorhanden?',
        '',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### Version {{version}}',
        '{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}',
        '{{#if body}}',
        '',
        '{{{body}}}',
        '',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
      matchPackageNames: [
        '/^postgres/',
        '/^mariadb/',
        '/^mysql/',
        '/^redis/',
        '/^mongo/',
        '/^valkey/',
        '/^memcached/',
      ],
    },
    {
      description: 'Traefik Plugins: IMMER PR (manuelle Deployment erforderlich)',
      automerge: false,
      prCreation: 'immediate',
      reviewers: [
        'nico',
      ],
      prBodyNotes: [
        '### 🔌 Traefik Plugin Update',
        '',
        '⚠️ **WICHTIG: Manuelles Deployment erforderlich!**',
        '',
        '📋 **Checkliste:**',
        '- [ ] Release Notes auf Breaking Changes prüfen',
        '- [ ] Config auf Server kopieren',
        '- [ ] Traefik neu starten',
        '- [ ] Funktionalität testen',
        '',
        '{{#if releases}}',
        '{{#each releases}}',
        '#### Version {{version}}',
        '{{#if url}}📦 [Release Notes]({{{url}}}){{/if}}',
        '{{#if body}}',
        '',
        '{{{body}}}',
        '',
        '{{/if}}',
        '{{/each}}',
        '{{/if}}',
      ],
      matchPackageNames: [
        '/traefik/',
        '/crowdsec/',
        '/geoblock/',
      ],
    },
    {
      description: 'Docker Compose Updates - pro Ordner gruppiert',
      matchManagers: [
        'docker-compose',
      ],
      groupName: '{{parentDir}}',
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessagePrefix: '[{{parentDir}}]',
    },
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 0,
  platformAutomerge: true,
  semanticCommits: 'enabled',
  dependencyDashboard: true,
  dependencyDashboardTitle: '🔄 Renovate Dashboard - Docker Updates',
  fetchChangeLogs: 'pr',
}
