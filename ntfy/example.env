
#   Format: <user>:<bcrypt-hash>:<role>
#   Rollen: admin | user
#   Hinweis: In docker-compose müssen `$` im bcrypt Hash als `$$` escaped werden.
#   Beispiel:
#     USER=test:$$2a$$12$$...:admin
USER: test:$$2a$$12$$...:admin
#   Format: <user>:<topic>:<permissions>
#   Topic: `*` als Wildcard (z.B. test:*:ro)
#   Permissions: rw | ro | wo | none
#   Beispiel:
#     ACCESS=test:*:rw
ACCESS: test:*:rw