# Gitea example environment
# Copy this file to `.env` next to compose.prod.yml and fill in real values.
#
# Beide Werte einmalig erzeugen und danach nie ändern - ein neuer SECRET_KEY
# macht alle gespeicherten Zugangsdaten (OAuth-Secrets, 2FA) unlesbar:
#
#   docker run --rm gitea/gitea:1.27.2-rootless gitea generate secret SECRET_KEY
#   docker run --rm gitea/gitea:1.27.2-rootless gitea generate secret INTERNAL_TOKEN

# Verschlüsselt Geheimnisse in der Datenbank
GITEA_SECRET_KEY=changeme

# Authentifiziert Giteas interne API-Aufrufe gegen sich selbst
GITEA_INTERNAL_TOKEN=changeme
