#!/usr/bin/env bash
#
# sops-Aufruf mit dem age-Schluessel dieser Arbeitsstation.
#
# sops sucht seinen Schluessel sonst als Datei unter ~/.config/sops/age. Genau
# das soll er hier nicht: Der private Schluessel liegt im selben Schluesselbund
# wie der Gitea-Token (`tools/tf`, `tools/gitea-credential`) - ein Ort fuer
# Geheimnisse auf dieser Maschine, nicht zwei. Eine Schluesseldatei neben dem
# Repo waere ausserdem genau die Art Datei, die beim naechsten `git add .` im
# falschen Verzeichnis mitgeht.
#
# Der Schluessel geht ueber die Umgebung an sops, nicht ueber ein Argument -
# Argumente stehen in der Prozessliste, die Umgebung eines fremden Prozesses
# nicht.
#
# Benutzung wie sops selbst:
#
#   tools/sops edit   clusters/talos-cp1/nextcloud-db.sops.yaml
#   tools/sops -d     clusters/talos-cp1/nextcloud-db.sops.yaml
#   tools/sops -e -i  clusters/talos-cp1/neu.sops.yaml
#
set -euo pipefail

#
# Beide kommen aus ansible/tools - sops als gepinnte Release-Binary, age und
# libsecret-tools als Pakete. Von Hand nachinstallieren waere genau das, was
# das Playbook verhindern soll: eine Binary ohne Update-Pfad.
#
for cmd in sops secret-tool; do
  command -v "$cmd" >/dev/null && continue
  echo "sops: $cmd fehlt" >&2
  echo "sops: einrichten -> cd ansible/tools && ansible-playbook -i inventory.ini tools.yml" >&2
  exit 1
done

age_key="$(secret-tool lookup homelab sops-age-key || true)"
if [ -z "$age_key" ]; then
  echo "sops: age-Schluessel nicht im Schluesselbund (Attribut homelab=sops-age-key)" >&2
  echo "sops: Gegenprobe -> secret-tool search --all homelab sops-age-key" >&2
  echo "sops: fehlt er wirklich, ist der Recovery-Schluessel der einzige Weg an" >&2
  echo "sops: die vorhandenen Dateien - siehe homelab-secrets/README.md" >&2
  exit 1
fi

#
# SOPS_AGE_KEY nimmt den Schluessel als Text entgegen, inklusive der
# Kommentarzeilen, die age-keygen erzeugt - der Eintrag im Schluesselbund ist
# die Datei, wie sie sonst auf der Platte laege.
#
export SOPS_AGE_KEY="$age_key"
unset age_key

exec sops "$@"
