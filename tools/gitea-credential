#!/usr/bin/env bash
#
# git-Credential-Helper fuer den eigenen Gitea.
#
# git kann mit dem Token im Schluesselbund nichts anfangen, solange ihm
# niemand sagt, wo er liegt. Dieser Helper holt Benutzer und Token aus
# demselben Eintrag, den auch `tf` benutzt (Attribut homelab=gitea-token) -
# ein Geheimnis, eine Stelle, kein zweiter Ort, der beim Tokenwechsel
# vergessen wird.
#
# Eintragen:
#   git config --global \
#     credential.https://git.local.nico-steinmueller.de.helper \
#     '!/home/nico/Repos/Homelab/Container/tools/gitea-credential'
#
set -euo pipefail

# `store` und `erase` gehen ins Leere: Der Schluesselbund wird von Hand
# gepflegt, nicht von git ueberschrieben.
[ "${1:-}" = get ] || exit 0

# Vorrang fuer die Umgebung, damit `tf` und CI ohne Schluesselbund laufen.
user="${TF_HTTP_USERNAME:-}"
token="${TF_HTTP_PASSWORD:-}"

if [ -z "$token" ]; then
  token="$(secret-tool lookup homelab gitea-token || true)"
  # Der Benutzername steht als Attribut am selben Eintrag. `secret-tool
  # search` schreibt die Attribute nach stderr, das Geheimnis nach stdout -
  # `2>&1 >/dev/null` laesst nur die Attribute in die Pipe.
  user="$(secret-tool search --all homelab gitea-token 2>&1 >/dev/null \
          | sed -n 's/^attribute\.username = //p' | head -1)"
fi

if [ -z "$token" ] || [ -z "$user" ]; then
  echo "gitea-credential: kein Gitea-Token im Schluesselbund (homelab=gitea-token)" >&2
  echo "gitea-credential: anlegen -> gitea/README.md, \"Geheimnisse im Schluesselbund\"" >&2
  exit 1
fi

echo "username=$user"
echo "password=$token"
