#!/usr/bin/env bash
#
# git-Credential-Helper fuer den eigenen Gitea.
#
# git kann mit dem Token nichts anfangen, solange ihm niemand sagt, wo er
# liegt. Dieser Helper liest dieselbe Datei, die auch `tf` benutzt
# (~/.config/homelab/gitea.env) - ein Geheimnis, eine Stelle, kein zweiter Ort,
# der beim Tokenwechsel vergessen wird.
#
# Eintragen:
#   git config --global \
#     credential.https://git.local.nico-steinmueller.de.helper \
#     '!/home/nico/Repos/Homelab/Container/tools/gitea-credential'
#
set -euo pipefail

# `store` und `erase` gehen ins Leere: Die Datei wird von Hand gepflegt, nicht
# von git ueberschrieben.
[ "${1:-}" = get ] || exit 0

# Vorrang fuer die Umgebung, damit `tf` und CI ohne die Datei laufen.
user="${TF_HTTP_USERNAME:-}"
token="${TF_HTTP_PASSWORD:-}"

if [ -z "$token" ]; then
  CONFIG="${HOMELAB_CONFIG:-$HOME/.config/homelab}"
  env_file="$CONFIG/gitea.env"
  if [ -r "$env_file" ]; then
    # shellcheck source=/dev/null
    . "$env_file"
    user="${HOMELAB_GITEA_USER:-}"
    token="${HOMELAB_GITEA_TOKEN:-}"
  fi
fi

if [ -z "$token" ] || [ -z "$user" ]; then
  echo "gitea-credential: kein Gitea-Token unter ${HOMELAB_CONFIG:-$HOME/.config/homelab}/gitea.env" >&2
  echo "gitea-credential: anlegen -> gitea/README.md, \"Geheimnisse auf der Arbeitsstation\"" >&2
  exit 1
fi

echo "username=$user"
echo "password=$token"
