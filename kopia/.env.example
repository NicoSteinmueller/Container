# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║                    Kopia Backup Server - Umgebungsvariablen                   ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║ Diese Datei nach .env kopieren und anpassen:                                 ║
# ║ cp .env.example .env                                                          ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# ════════════════════════════════════════════════════════════════════════════════
# Repository-Konfiguration
# ════════════════════════════════════════════════════════════════════════════════

# Repository-Verschlüsselungspasswort (WICHTIG: Gut aufbewahren!)
# Ohne dieses Passwort können Backups NICHT wiederhergestellt werden!
KOPIA_REPOSITORY_PASSWORD=kopia1#

# ════════════════════════════════════════════════════════════════════════════════
# Web-UI Zugangsdaten
# ════════════════════════════════════════════════════════════════════════════════

KOPIA_SERVER_USERNAME=admin
KOPIA_SERVER_PASSWORD=kopia123

# ════════════════════════════════════════════════════════════════════════════════
# Verzeichnisse
# ════════════════════════════════════════════════════════════════════════════════

# Kopia Datenverzeichnis (Konfiguration, Cache, Logs)
KOPIA_DATA_DIR=./kopia-data

# Backup-Repository Speicherort (wo die Backups gespeichert werden)
KOPIA_REPOSITORY_DIR=./backup

# ════════════════════════════════════════════════════════════════════════════════
# Quellordner - Daten die gesichert werden sollen
# ════════════════════════════════════════════════════════════════════════════════
#
# Für jeden Quellordner:
# - KOPIA_SOURCE_X: Absoluter oder relativer Pfad zum Quellordner auf dem Host
# - KOPIA_SOURCE_X_NAME: Name unter dem der Ordner in /data/ im Container erscheint
#
# WICHTIG: Nicht verwendete Quellen (2-6) müssen in docker-compose.yml auskommentiert sein!
#          Quellen 7-20 sind dort bereits auskommentiert.
# ════════════════════════════════════════════════════════════════════════════════

# Quellordner 1 (Standard - bereits in docker-compose.yml aktiviert)
KOPIA_SOURCE_1=./daten
KOPIA_SOURCE_1_NAME=daten

# Quellordner 2 (in docker-compose.yml einkommentieren, wenn verwendet)
#KOPIA_SOURCE_2=C:/Dokumente
#KOPIA_SOURCE_2_NAME=dokumente

# Quellordner 3 (in docker-compose.yml einkommentieren, wenn verwendet)
#KOPIA_SOURCE_3=C:/Bilder
#KOPIA_SOURCE_3_NAME=bilder

# Quellordner 4 (in docker-compose.yml einkommentieren, wenn verwendet)
#KOPIA_SOURCE_4=D:/Videos
#KOPIA_SOURCE_4_NAME=videos

# Quellordner 5 (in docker-compose.yml einkommentieren, wenn verwendet)
#KOPIA_SOURCE_5=E:/Musik
#KOPIA_SOURCE_5_NAME=musik

# Quellordner 6 (in docker-compose.yml einkommentieren, wenn verwendet)
#KOPIA_SOURCE_6=C:/Projekte
#KOPIA_SOURCE_6_NAME=projekte

# ════════════════════════════════════════════════════════════════════════════════
# Netzwerk & System
# ════════════════════════════════════════════════════════════════════════════════

# Port für die Web-UI
KOPIA_PORT=51515


