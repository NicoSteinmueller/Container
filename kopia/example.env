# ╔═══════════════════════════════════════════════════════════════════════════════╗
# ║                    Kopia Backup Server - Umgebungsvariablen                   ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║ Variable                  │ Beschreibung                          │ Standard  ║
# ╠═══════════════════════════════════════════════════════════════════════════════╣
# ║ INSTANCE                  │ Bezeichnung der Instance              │ main      ║
# ║ KOPIA_REPOSITORY_DIR      │ Backup-Repository Speicherort         │ default   ║
# ║ KOPIA_REPOSITORY_PASSWORD │ Repository-Verschlüsselungspasswort   │ required  ║
# ║ KOPIA_SERVER_USERNAME     │ Web-UI Benutzername                   │ admin     ║
# ║ KOPIA_SERVER_PASSWORD     │ Web-UI Passwort                       │ required  ║
# ╚═══════════════════════════════════════════════════════════════════════════════╝

# Instance-Bezeichnung für mehrere Instanzen
 INSTANCE=main

# Repository-Speicherort
 KOPIA_REPOSITORY_DIR=/path/to/repository

# Verschlüsselungspasswort für das Backup-Repository
KOPIA_REPOSITORY_PASSWORD=change_me

# Web-UI Benutzername
KOPIA_SERVER_USERNAME=admin

# Web-UI Passwort
KOPIA_SERVER_PASSWORD=change_me
