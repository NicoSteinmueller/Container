# === DATENBANK & SICHERHEIT ===
# PostgreSQL Datenbank-Passwort
# WICHTIG: In Production ein sicheres Passwort verwenden!
DB_PASSWORD=changeme

# Django Secret Key - mindestens 50 Zeichen (AlphaNum + Sonderzeichen)
# Generieren mit: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
PAPERLESS_SECRET_KEY=your-secret-key-min-50-chars-here-change-this-in-production

# === KEYCLOAK / OIDC INTEGRATION ===
# Client Secret für Keycloak OIDC
# Nur erforderlich, wenn SSO aktiviert sein soll
# KEYCLOAK_SECRET=your-keycloak-client-secret

# Automatisches Anlegen von Usern bei erstem SSO-Login
PAPERLESS_ALLOW_SIGNUPS=false

# Deaktiviert Login-Formular, erzwingt SSO
PAPERLESS_DISABLE_REGULAR_LOGIN=true

# === ERWEITERTE KONFIGURATION ===
# Komma-getrennte Liste von Daten, die bei Erkennung ignoriert werden
# Beispiel: 25.04.1985,01.01.2000
PAPERLESS_IGNORE_DATES=

KEYCLOAK_SECRET=your-keycloak-client-secret
