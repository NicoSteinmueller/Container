# ============================================
# Paperless-ngx Multi-Instanz Konfiguration
# ============================================
#
# Diese Datei als .env kopieren und anpassen:
# cp example.env .env
#
# Für Portainer: Variablen direkt im Stack-Editor setzen

# ============================================
# INSTANZ-KONFIGURATION
# ============================================

# Name der Instanz (wird für Container, Volumes und Netzwerke verwendet)
# Beispiele: main, archive, family, work
INSTANCE_NAME=main

# Externer Port für das Webinterface
# Jede Instanz benötigt einen eigenen Port
INSTANCE_PORT=61349


# ============================================
# DATENBANK & SICHERHEIT
# ============================================

# PostgreSQL Datenbank-Passwort
# WICHTIG: Für jede Instanz ein eigenes, sicheres Passwort verwenden!
DB_PASSWORD=changeme

# Django Secret Key (PFLICHTFELD!)
# Mindestens 50 Zeichen (AlphaNum + Sonderzeichen)
PAPERLESS_SECRET_KEY=changeme


# ============================================
# HOST PATH MOUNTS
# ============================================

# Grundpfad auf dem Host für Instanz-Daten
# Die tatsächlichen Pfade werden automatisch generiert:
#   ${PAPERLESS_DATA_BASE_PATH}/${INSTANCE_NAME}/consume
#   ${PAPERLESS_DATA_BASE_PATH}/${INSTANCE_NAME}/export
#   ${PAPERLESS_DATA_BASE_PATH}/${INSTANCE_NAME}/media
#
# Beispiele:
#   ./data          → ./data/main/consume, ./data/main/export, ./data/main/media
#   /mnt/paperless  → /mnt/paperless/main/consume, etc.
PAPERLESS_DATA_BASE_PATH=./data


# ============================================
# URL & PATH-ROUTING (Reverse Proxy)
# ============================================

# Externe Basis-URL OHNE Subpath
# Beispiele:
#   https://docs.example.com
#   https://example.com
#   http://192.168.178.50
# Leer lassen für lokalen Zugriff ohne Proxy
PAPERLESS_URL=

# Subpath für die Instanz (für Deployment unter einem Subpath)
# Wird verwendet für FORCE_SCRIPT_NAME und STATIC_URL
# Beispiele:
#   /paperless-main
#   /docs
#   /paperless/${INSTANCE_NAME}
# Leer lassen für Root-Deployment (/)
PAPERLESS_SUBPATH=


# ============================================
# KEYCLOAK / OIDC INTEGRATION (optional)
# ============================================

# JSON-Konfiguration für OpenID Connect Provider
# Format:
# {"openid_connect":{"APPS":[{"provider_id":"keycloak","name":"Keycloak","client_id":"paperless-main","secret":"CLIENT_SECRET","settings":{"server_url":"https://keycloak.example.com/realms/homelab/.well-known/openid-configuration"}}],"OAUTH_PKCE_ENABLED":true}}
#
# WICHTIG: Für jede Instanz eine eigene client_id in Keycloak anlegen!
# Beispiele:
#   client_id: paperless-main, paperless-archive, paperless-family
KEYCLOAK_CONFIG=

# Automatisches Anlegen von Usern bei erstem SSO-Login
# true  = Neue User werden automatisch erstellt
# false = Nur bereits existierende User können sich einloggen
PAPERLESS_ALLOW_SIGNUPS=false

# Deaktiviert das Standard-Login-Formular (erzwingt SSO-Login)
# true  = Nur SSO-Login möglich
# false = Sowohl SSO als auch Standard-Login möglich
PAPERLESS_DISABLE_REGULAR_LOGIN=true

# Single Logout URL für Keycloak
# Leitet nach lokalem Logout zu Keycloak weiter, um auch dort die Session zu beenden
# Format: https://keycloak.example.com/realms/REALM/protocol/openid-connect/logout?post_logout_redirect_uri=REDIRECT_URL&client_id=CLIENT_ID
# Beispiel: https://keycloak.example.com/realms/homelab/protocol/openid-connect/logout?post_logout_redirect_uri=https://docs.example.com/paperless-main&client_id=paperless-main
# WICHTIG: Die post_logout_redirect_uri muss in Keycloak als "Valid post logout redirect URI" eingetragen sein!
PAPERLESS_LOGOUT_REDIRECT_URL=


# ============================================
# ERWEITERTE KONFIGURATION
# ============================================

# Daten, die bei der automatischen Datumserkennung ignoriert werden sollen
# Nützlich für häufig vorkommende Daten wie Geburtsdaten
# Format: Komma-getrennte Liste
# Beispiel: 25.04.1985,01.01.2000,15.08.1992
PAPERLESS_IGNORE_DATES=
